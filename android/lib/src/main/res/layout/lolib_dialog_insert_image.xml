<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/lolib_bg_ai_sheet_container" android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="#ffffff" android:layout_width="match_parent" android:layout_height="43dp" android:paddingStart="12dp" android:paddingEnd="12dp">
                <ImageButton android:id="@+id/insertImageBackBtn" android:background="?attr/selectableItemBackgroundBorderless" android:padding="4dp" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/lolib_ic_top_back" android:scaleType="centerinside" android:tint="#333333" android:contentDescription="@string/back_label"/>
                <TextView android:textSize="16sp" android:textColor="#333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/insert_image_title" android:layout_marginStart="8dp"/>
        </LinearLayout>
        <View android:background="#a2a9b2" android:layout_width="match_parent" android:layout_height="1px"/>
        <LinearLayout android:orientation="horizontal" android:background="@drawable/bg_insert_image_segment" android:padding="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp">
                <TextView android:textSize="16sp" android:textColor="#101010" android:gravity="center" android:id="@+id/insertImageAlbumTab" android:background="@drawable/bg_insert_image_segment_active" android:layout_width="0dp" android:layout_height="30dp" android:text="@string/insert_image_album" android:layout_weight="1"/>
                <TextView android:textSize="16sp" android:textColor="#6a6a6a" android:gravity="center" android:id="@+id/insertImageCameraTab" android:background="@drawable/bg_insert_image_segment_idle" android:layout_width="0dp" android:layout_height="30dp" android:text="@string/insert_image_camera" android:layout_weight="1"/>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/insertImageGrid" android:paddingBottom="12dp" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="2" android:paddingStart="16dp" android:paddingEnd="16dp"/>
                <TextView android:textSize="14sp" android:textColor="#8a8a8e" android:layout_gravity="center" android:id="@+id/insertImageEmptyText" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/insert_image_no_photo"/>
        </FrameLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:textSize="16sp" android:textColor="#1278d9" android:gravity="center_vertical" android:id="@+id/insertImagePreviewBtn" android:padding="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/insert_image_preview"/>
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                <TextView android:textSize="16sp" android:textColor="#ffffff" android:gravity="center" android:id="@+id/insertImageConfirmBtn" android:background="@drawable/bg_insert_image_done" android:layout_width="wrap_content" android:layout_height="31dp" android:minWidth="92dp" android:paddingStart="20dp" android:paddingEnd="20dp"/>
        </LinearLayout>
</LinearLayout>
