<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="335dp"
    android:layout_height="wrap_content"
    android:background="@drawable/lolib_wai_bg_dialog"
    android:paddingBottom="12dp">

    <include layout="@layout/lolib_wai_header" />

    <FrameLayout
        android:id="@+id/wai_format_input_group"
        android:layout_width="match_parent"
       android:layout_height="0dp"
       android:layout_weight="1"
       android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/lolib_wai_bg_box"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"
                android:scrollbarSize="4dp"
                android:scrollbarThumbVertical="@drawable/lolib_wai_scrollbar"
                android:scrollbarStyle="insideOverlay">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:id="@+id/wai_format_row_0">
                        <TextView android:id="@+id/wai_format_label_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="16sp" android:textColor="#333333" android:text="" />
                        <CheckBox android:id="@+id/wai_format_check_0" android:layout_width="28dp" android:layout_height="28dp" android:button="@drawable/lolib_wai_cb_selector" android:background="@null" android:minWidth="0dp" android:minHeight="0dp" android:scaleX="0.86" android:scaleY="0.86" android:paddingLeft="0dp" android:paddingRight="0dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:id="@+id/wai_format_row_1">
                        <TextView android:id="@+id/wai_format_label_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="16sp" android:textColor="#333333" android:text="" />
                        <CheckBox android:id="@+id/wai_format_check_1" android:layout_width="28dp" android:layout_height="28dp" android:button="@drawable/lolib_wai_cb_selector" android:background="@null" android:minWidth="0dp" android:minHeight="0dp" android:scaleX="0.86" android:scaleY="0.86" android:paddingLeft="0dp" android:paddingRight="0dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:id="@+id/wai_format_row_2">
                        <TextView android:id="@+id/wai_format_label_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="16sp" android:textColor="#333333" android:text="" />
                        <CheckBox android:id="@+id/wai_format_check_2" android:layout_width="28dp" android:layout_height="28dp" android:button="@drawable/lolib_wai_cb_selector" android:background="@null" android:minWidth="0dp" android:minHeight="0dp" android:scaleX="0.86" android:scaleY="0.86" android:paddingLeft="0dp" android:paddingRight="0dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:id="@+id/wai_format_row_3">
                        <TextView android:id="@+id/wai_format_label_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="16sp" android:textColor="#333333" android:text="" />
                        <CheckBox android:id="@+id/wai_format_check_3" android:layout_width="28dp" android:layout_height="28dp" android:button="@drawable/lolib_wai_cb_selector" android:background="@null" android:minWidth="0dp" android:minHeight="0dp" android:scaleX="0.86" android:scaleY="0.86" android:paddingLeft="0dp" android:paddingRight="0dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:id="@+id/wai_format_row_4">
                        <TextView android:id="@+id/wai_format_label_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="16sp" android:textColor="#333333" android:text="" />
                        <CheckBox android:id="@+id/wai_format_check_4" android:layout_width="28dp" android:layout_height="28dp" android:button="@drawable/lolib_wai_cb_selector" android:background="@null" android:minWidth="0dp" android:minHeight="0dp" android:scaleX="0.86" android:scaleY="0.86" android:paddingLeft="0dp" android:paddingRight="0dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:id="@+id/wai_format_row_5">
                        <TextView android:id="@+id/wai_format_label_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="16sp" android:textColor="#333333" android:text="" />
                        <CheckBox android:id="@+id/wai_format_check_5" android:layout_width="28dp" android:layout_height="28dp" android:button="@drawable/lolib_wai_cb_selector" android:background="@null" android:minWidth="0dp" android:minHeight="0dp" android:scaleX="0.86" android:scaleY="0.86" android:paddingLeft="0dp" android:paddingRight="0dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/wai_format_result_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/lolib_wai_bg_box"
            android:orientation="vertical"
            android:padding="10dp">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/wai_format_result_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="vertical"
                android:scrollbarSize="4dp"
                android:scrollbarThumbVertical="@drawable/lolib_wai_scrollbar"
                android:scrollbarStyle="insideOverlay">

                <TextView
                    android:id="@+id/wai_format_result_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#101010"
                    android:lineSpacingExtra="8dp"
                    android:text="" />
            </androidx.core.widget.NestedScrollView>

            <LinearLayout
                android:id="@+id/wai_format_copy_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/lolib_wai_ic_copy"
                    android:contentDescription="复制" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="14sp"
                    android:textColor="#6A6A6A"
                    android:text="复制" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wai_format_cta_bar"
        android:layout_width="match_parent"
        android:layout_height="59dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:id="@+id/wai_format_execute_btn"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="1"
            android:background="@drawable/lolib_bg_continue_pill_primary_35"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/lolib_wai_ic_sparkle"
                android:contentDescription="执行" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:text="开始执行" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wai_format_result_bar"
        android:layout_width="match_parent"
        android:layout_height="59dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/wai_format_regenerate_btn"
            android:layout_width="120dp"
            android:layout_height="35dp"
            android:background="@drawable/lolib_bg_continue_pill_secondary_35"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="#E5000000"
            android:clickable="true"
            android:focusable="true"
            android:text="重新生成" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/wai_format_insert_btn"
            android:layout_width="120dp"
            android:layout_height="35dp"
            android:background="@drawable/lolib_bg_continue_pill_primary_35"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:text="插入文档" />
    </LinearLayout>
</LinearLayout>
