<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 5632:26268/26294 查找替换底部弹窗（查找/替换 双 tab） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingBottom="@dimen/lolib_function_sheet_bottom_pad">

    <!-- 标题栏：设置 / 查找替换 / 关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/find_sheet_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="设置"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/lolib_ic_find_settings" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="查找替换"
            android:textColor="#101010"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />

        <ImageButton
            android:id="@+id/find_sheet_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/lolib_ic_sheet_close_80" />
    </LinearLayout>

    <!-- 查找/替换 分段控件（Figma 轨道 #F2F3F5 圆角 8dp，选中白底深字） -->
    <LinearLayout
        android:id="@+id/find_tab_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/lolib_bg_find_segment_track"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/find_tab_find"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/lolib_bg_find_segment_active"
            android:gravity="center"
            android:text="查找"
            android:textColor="#101010"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/find_tab_replace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/lolib_bg_find_segment_inactive"
            android:gravity="center"
            android:text="替换"
            android:textColor="#6A6A6A"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 查找 tab 内容 -->
    <LinearLayout
        android:id="@+id/find_panel_find"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <!-- 查找输入框（Figma 边框 #D8D8D8，有输入变 #101010） -->
        <EditText
            android:id="@+id/find_query_input"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/lolib_bg_find_search_field"
            android:hint="请输入查找内容"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#101010"
            android:textColorHint="#999999"
            android:textSize="16sp" />

        <!-- 上一处 / 下一处（空态灰字 #CCCCCC，有输入深字 #101010） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/find_btn_prev"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/lolib_bg_find_nav_button"
                android:gravity="center"
                android:text="上一处"
                android:textColor="#CCCCCC"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/find_btn_next"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/lolib_bg_find_nav_button"
                android:gravity="center"
                android:text="下一处"
                android:textColor="#CCCCCC"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 替换 tab 内容（Figma 5632:26327/26359） -->
    <LinearLayout
        android:id="@+id/find_panel_replace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/find_replace_query_input"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/lolib_bg_find_search_field"
            android:hint="请输入查找内容"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#101010"
            android:textColorHint="#999999"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/find_replace_with_input"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/lolib_bg_find_search_field"
            android:hint="请输入替换内容"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#101010"
            android:textColorHint="#999999"
            android:textSize="16sp" />

        <!-- 上一处 / 下一处 / 全部替换 / 替换 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/find_replace_btn_prev"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/lolib_bg_find_nav_button"
                android:gravity="center"
                android:text="上一处"
                android:textColor="#CCCCCC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/find_replace_btn_next"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/lolib_bg_find_nav_button"
                android:gravity="center"
                android:text="下一处"
                android:textColor="#CCCCCC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/find_replace_btn_all"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/lolib_bg_find_nav_button"
                android:gravity="center"
                android:text="全部替换"
                android:textColor="#CCCCCC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/find_replace_btn_one"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="1"
                android:background="@drawable/lolib_bg_find_replace_primary"
                android:gravity="center"
                android:text="替换"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
