<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@android:color/transparent" android:paddingBottom="@dimen/lolib_function_sheet_bottom_pad" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="@dimen/find_sheet_header_height" android:paddingStart="12dp" android:paddingEnd="12dp">
                <ImageButton android:id="@+id/find_sheet_settings" android:background="?attr/selectableItemBackgroundBorderless" android:padding="6dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/lolib_ic_find_settings" android:scaleType="centerInside" android:contentDescription="设置"/>
                <TextView android:textSize="18sp" android:textColor="#101010" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:text="查找替换" android:layout_weight="1" android:fontFamily="sans-serif-medium"/>
                <ImageButton android:id="@+id/find_sheet_close" android:background="?attr/selectableItemBackgroundBorderless" android:padding="4dp" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/lolib_ic_sheet_close_80" android:scaleType="fitCenter" android:contentDescription="关闭"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:id="@+id/find_tab_bar" android:background="@drawable/lolib_bg_find_segment_track" android:paddingTop="@dimen/find_sheet_tab_track_padding_v" android:paddingBottom="@dimen/find_sheet_tab_track_padding_v" android:layout_width="match_parent" android:layout_height="@dimen/find_sheet_tab_track_height" android:layout_marginTop="@dimen/find_sheet_section_gap" android:paddingStart="@dimen/find_sheet_tab_track_padding_h" android:paddingEnd="@dimen/find_sheet_tab_track_padding_h" android:layout_marginStart="@dimen/find_sheet_content_margin_h" android:layout_marginEnd="@dimen/find_sheet_content_margin_h">
                <TextView android:textSize="16sp" android:textColor="#101010" android:gravity="center" android:id="@+id/find_tab_find" android:background="@drawable/lolib_bg_find_segment_active" android:layout_width="0dp" android:layout_height="match_parent" android:text="查找" android:layout_weight="1"/>
                <TextView android:textSize="16sp" android:textColor="#6a6a6a" android:gravity="center" android:id="@+id/find_tab_replace" android:background="@drawable/lolib_bg_find_segment_inactive" android:layout_width="0dp" android:layout_height="match_parent" android:text="替换" android:layout_weight="1" android:layout_marginStart="@dimen/find_sheet_tab_gap"/>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:id="@+id/find_panel_find" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/find_sheet_content_margin_h" android:layout_marginEnd="@dimen/find_sheet_content_margin_h">
                <EditText android:textSize="16sp" android:textColor="#101010" android:textColorHint="#999999" android:id="@+id/find_query_input" android:background="@drawable/lolib_bg_find_search_field" android:layout_width="match_parent" android:layout_height="@dimen/find_sheet_field_height" android:layout_marginTop="@dimen/find_sheet_section_gap" android:hint="请输入查找内容" android:inputType="text" android:imeOptions="actionSearch" android:paddingStart="16dp" android:paddingEnd="16dp"/>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/find_sheet_section_gap">
                        <TextView android:textSize="16sp" android:textColor="#cccccc" android:gravity="center" android:id="@+id/find_btn_prev" android:background="@drawable/lolib_bg_find_nav_button" android:layout_width="0dp" android:layout_height="@dimen/find_sheet_action_row_height" android:text="上一处" android:layout_weight="1" android:layout_marginEnd="8dp"/>
                        <TextView android:textSize="16sp" android:textColor="#cccccc" android:gravity="center" android:id="@+id/find_btn_next" android:background="@drawable/lolib_bg_find_nav_button" android:layout_width="0dp" android:layout_height="@dimen/find_sheet_action_row_height" android:text="下一处" android:layout_weight="1" android:layout_marginStart="8dp"/>
                </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:id="@+id/find_panel_replace" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/find_sheet_content_margin_h" android:layout_marginEnd="@dimen/find_sheet_content_margin_h">
                <EditText android:textSize="16sp" android:textColor="#101010" android:textColorHint="#999999" android:id="@+id/find_replace_query_input" android:background="@drawable/lolib_bg_find_search_field" android:layout_width="match_parent" android:layout_height="@dimen/find_sheet_field_height" android:layout_marginTop="@dimen/find_sheet_section_gap" android:hint="请输入查找内容" android:inputType="text" android:paddingStart="16dp" android:paddingEnd="16dp"/>
                <EditText android:textSize="16sp" android:textColor="#101010" android:textColorHint="#999999" android:id="@+id/find_replace_with_input" android:background="@drawable/lolib_bg_find_search_field" android:layout_width="match_parent" android:layout_height="@dimen/find_sheet_field_height" android:layout_marginTop="@dimen/find_sheet_replace_field_gap" android:hint="请输入替换内容" android:inputType="text" android:paddingStart="16dp" android:paddingEnd="16dp"/>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/find_sheet_section_gap">
                        <TextView android:textSize="14sp" android:textColor="#cccccc" android:gravity="center" android:id="@+id/find_replace_btn_prev" android:background="@drawable/lolib_bg_find_nav_button" android:layout_width="0dp" android:layout_height="@dimen/find_sheet_action_row_height" android:text="上一处" android:layout_weight="1" android:layout_marginEnd="@dimen/find_sheet_action_button_gap"/>
                        <TextView android:textSize="14sp" android:textColor="#cccccc" android:gravity="center" android:id="@+id/find_replace_btn_next" android:background="@drawable/lolib_bg_find_nav_button" android:layout_width="0dp" android:layout_height="@dimen/find_sheet_action_row_height" android:text="下一处" android:layout_weight="1" android:layout_marginEnd="@dimen/find_sheet_action_button_gap"/>
                        <TextView android:textSize="14sp" android:textColor="#cccccc" android:gravity="center" android:id="@+id/find_replace_btn_all" android:background="@drawable/lolib_bg_find_nav_button" android:layout_width="0dp" android:layout_height="@dimen/find_sheet_action_row_height" android:text="全部替换" android:layout_weight="1" android:layout_marginEnd="@dimen/find_sheet_action_button_gap"/>
                        <TextView android:textSize="14sp" android:textColor="#ffffff" android:gravity="center" android:id="@+id/find_replace_btn_one" android:background="@drawable/lolib_bg_find_replace_primary" android:layout_width="0dp" android:layout_height="@dimen/find_sheet_action_row_height" android:text="替换" android:layout_weight="1"/>
                </LinearLayout>
        </LinearLayout>
</LinearLayout>
