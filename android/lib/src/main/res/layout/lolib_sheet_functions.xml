<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 125:12715 / 125:12974 预览态功能弹窗：750×696@2x，行 128px=64dp，底 pad 68px=34dp -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:paddingBottom="@dimen/lolib_function_sheet_bottom_pad">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/function_sheet_header_height"
        android:paddingStart="@dimen/function_sheet_header_padding_h"
        android:paddingEnd="@dimen/function_sheet_header_padding_h">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="功能"
            android:textColor="#15171A"
            android:textSize="@dimen/function_sheet_title_text_size"
            android:fontFamily="sans-serif-medium" />

        <ImageButton
            android:id="@+id/function_sheet_close"
            android:layout_width="@dimen/function_sheet_close_size"
            android:layout_height="@dimen/function_sheet_close_size"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭"
            android:padding="@dimen/function_sheet_close_icon_padding"
            android:scaleType="centerInside"
            android:src="@drawable/lolib_ic_dialog_close" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/function_sheet_tab_track_height"
        android:layout_marginStart="@dimen/function_sheet_content_margin_h"
        android:layout_marginTop="@dimen/function_sheet_section_gap"
        android:layout_marginEnd="@dimen/function_sheet_content_margin_h"
        android:background="@drawable/lolib_bg_function_tab_track"
        android:orientation="horizontal"
        android:paddingStart="@dimen/function_sheet_tab_track_padding_h"
        android:paddingTop="@dimen/function_sheet_tab_track_padding_v"
        android:paddingEnd="@dimen/function_sheet_tab_track_padding_h"
        android:paddingBottom="@dimen/function_sheet_tab_track_padding_v">

        <TextView
            android:id="@+id/function_tab_file"
            android:layout_width="0dp"
            android:layout_height="@dimen/function_sheet_tab_item_height"
            android:layout_weight="1"
            android:background="@drawable/lolib_bg_function_tab_active"
            android:gravity="center"
            android:text="文件操作"
            android:textColor="#101010"
            android:textSize="@dimen/function_sheet_tab_text_size" />

        <TextView
            android:id="@+id/function_tab_review"
            android:layout_width="0dp"
            android:layout_height="@dimen/function_sheet_tab_item_height"
            android:layout_marginStart="@dimen/function_sheet_tab_gap"
            android:layout_weight="1"
            android:background="@drawable/lolib_bg_function_tab_inactive"
            android:gravity="center"
            android:text="审阅"
            android:textColor="#6A6A6A"
            android:textSize="@dimen/function_sheet_tab_text_size" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/function_file_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/function_sheet_content_margin_h"
        android:layout_marginTop="@dimen/function_sheet_section_gap"
        android:layout_marginEnd="@dimen/function_sheet_content_margin_h"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/function_action_save"
            android:layout_width="match_parent"
            android:layout_height="@dimen/function_sheet_row_height"
            android:background="@drawable/lolib_bg_function_sheet_row_bottom_border"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/function_sheet_row_padding_h"
            android:paddingTop="@dimen/function_sheet_row_padding_v"
            android:paddingEnd="@dimen/function_sheet_row_padding_h"
            android:paddingBottom="@dimen/function_sheet_row_padding_v">

            <ImageView
                android:layout_width="@dimen/function_sheet_row_icon_size"
                android:layout_height="@dimen/function_sheet_row_icon_size"
                android:contentDescription="保存"
                android:src="@drawable/lolib_ic_function_save" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/function_sheet_row_icon_text_gap"
                android:text="保存"
                android:textColor="#333333"
                android:textSize="@dimen/function_sheet_row_text_size" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/function_action_download"
            android:layout_width="match_parent"
            android:layout_height="@dimen/function_sheet_row_height"
            android:background="@drawable/lolib_bg_function_sheet_row_bottom_border"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/function_sheet_row_padding_h"
            android:paddingTop="@dimen/function_sheet_row_padding_v"
            android:paddingEnd="@dimen/function_sheet_row_padding_h"
            android:paddingBottom="@dimen/function_sheet_row_padding_v">

            <ImageView
                android:layout_width="@dimen/function_sheet_row_icon_size"
                android:layout_height="@dimen/function_sheet_row_icon_size"
                android:contentDescription="下载"
                android:src="@drawable/lolib_ic_function_download" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/function_sheet_row_icon_text_gap"
                android:text="下载"
                android:textColor="#333333"
                android:textSize="@dimen/function_sheet_row_text_size" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/function_action_print"
            android:layout_width="match_parent"
            android:layout_height="@dimen/function_sheet_row_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/function_sheet_row_padding_h"
            android:paddingTop="@dimen/function_sheet_row_padding_v"
            android:paddingEnd="@dimen/function_sheet_row_padding_h"
            android:paddingBottom="@dimen/function_sheet_row_padding_v">

            <ImageView
                android:layout_width="@dimen/function_sheet_row_icon_size"
                android:layout_height="@dimen/function_sheet_row_icon_size"
                android:contentDescription="打印"
                android:src="@drawable/lolib_ic_function_print" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/function_sheet_row_icon_text_gap"
                android:text="打印"
                android:textColor="#333333"
                android:textSize="@dimen/function_sheet_row_text_size" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/function_review_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/function_sheet_content_margin_h"
        android:layout_marginTop="@dimen/function_sheet_section_gap"
        android:layout_marginEnd="@dimen/function_sheet_content_margin_h"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/function_action_word_count"
            android:layout_width="match_parent"
            android:layout_height="@dimen/function_sheet_row_height"
            android:background="@drawable/lolib_bg_function_sheet_row_bottom_border"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/function_sheet_row_padding_h"
            android:paddingTop="@dimen/function_sheet_row_padding_v"
            android:paddingEnd="@dimen/function_sheet_row_padding_h"
            android:paddingBottom="@dimen/function_sheet_row_padding_v">

            <ImageView
                android:layout_width="@dimen/function_sheet_row_icon_size"
                android:layout_height="@dimen/function_sheet_row_icon_size"
                android:contentDescription="字数统计"
                android:src="@drawable/lolib_ic_function_word_count" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/function_sheet_row_icon_text_gap"
                android:text="字数统计"
                android:textColor="#333333"
                android:textSize="@dimen/function_sheet_row_text_size" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/function_action_find_replace"
            android:layout_width="match_parent"
            android:layout_height="@dimen/function_sheet_row_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/function_sheet_row_padding_h"
            android:paddingTop="@dimen/function_sheet_row_padding_v"
            android:paddingEnd="@dimen/function_sheet_row_padding_h"
            android:paddingBottom="@dimen/function_sheet_row_padding_v">

            <ImageView
                android:layout_width="@dimen/function_sheet_row_icon_size"
                android:layout_height="@dimen/function_sheet_row_icon_size"
                android:contentDescription="查找替换"
                android:src="@drawable/lolib_ic_function_find_replace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/function_sheet_row_icon_text_gap"
                android:text="查找替换"
                android:textColor="#333333"
                android:textSize="@dimen/function_sheet_row_text_size" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
