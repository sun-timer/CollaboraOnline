        </FrameLayout>
        <LinearLayout android:orientation="horizontal" android:background="@drawable/lolib_bg_function_tab_track" android:paddingTop="@dimen/function_sheet_tab_track_padding_v" android:paddingBottom="@dimen/function_sheet_tab_track_padding_v" android:layout_width="match_parent" android:layout_height="@dimen/function_sheet_tab_track_height" android:layout_marginTop="@dimen/function_sheet_section_gap" android:paddingStart="@dimen/function_sheet_tab_track_padding_h" android:paddingEnd="@dimen/function_sheet_tab_track_padding_h" android:layout_marginStart="@dimen/function_sheet_content_margin_h" android:layout_marginEnd="@dimen/function_sheet_content_margin_h">
                <TextView android:textSize="@dimen/function_sheet_tab_text_size" android:textColor="#101010" android:gravity="center" android:id="@+id/function_tab_file" android:background="@drawable/lolib_bg_function_tab_active" android:layout_width="0dp" android:layout_height="@dimen/function_sheet_tab_item_height" android:text="文件操作" android:layout_weight="1"/>
                <TextView android:textSize="@dimen/function_sheet_tab_text_size" android:textColor="#6a6a6a" android:gravity="center" android:id="@+id/function_tab_review" android:background="@drawable/lolib_bg_function_tab_inactive" android:layout_width="0dp" android:layout_height="@dimen/function_sheet_tab_item_height" android:text="审阅" android:layout_weight="1" android:layout_marginStart="@dimen/function_sheet_tab_gap"/>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:id="@+id/function_file_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/function_sheet_section_gap" android:layout_marginStart="@dimen/function_sheet_content_margin_h" android:layout_marginEnd="@dimen/function_sheet_content_margin_h">
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/function_action_save" android:background="@drawable/lolib_bg_function_sheet_row_bottom_border" android:paddingTop="@dimen/function_sheet_row_padding_v" android:paddingBottom="@dimen/function_sheet_row_padding_v" android:layout_width="match_parent" android:layout_height="@dimen/function_sheet_row_height" android:paddingStart="@dimen/function_sheet_row_padding_h" android:paddingEnd="@dimen/function_sheet_row_padding_h">
                        <ImageView android:layout_width="@dimen/function_sheet_row_icon_size" android:layout_height="@dimen/function_sheet_row_icon_size" android:src="@drawable/lolib_ic_function_save" android:contentDescription="保存"/>
                        <TextView android:textSize="@dimen/function_sheet_row_text_size" android:textColor="#333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="保存" android:layout_marginStart="@dimen/function_sheet_row_icon_text_gap"/>
                </LinearLayout>
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/function_action_download" android:background="@drawable/lolib_bg_function_sheet_row_bottom_border" android:paddingTop="@dimen/function_sheet_row_padding_v" android:paddingBottom="@dimen/function_sheet_row_padding_v" android:layout_width="match_parent" android:layout_height="@dimen/function_sheet_row_height" android:paddingStart="@dimen/function_sheet_row_padding_h" android:paddingEnd="@dimen/function_sheet_row_padding_h">
                        <ImageView android:layout_width="@dimen/function_sheet_row_icon_size" android:layout_height="@dimen/function_sheet_row_icon_size" android:src="@drawable/lolib_ic_function_download" android:contentDescription="下载"/>
                        <TextView android:textSize="@dimen/function_sheet_row_text_size" android:textColor="#333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="下载" android:layout_marginStart="@dimen/function_sheet_row_icon_text_gap"/>
                </LinearLayout>
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/function_action_print" android:paddingTop="@dimen/function_sheet_row_padding_v" android:paddingBottom="@dimen/function_sheet_row_padding_v" android:layout_width="match_parent" android:layout_height="@dimen/function_sheet_row_height" android:paddingStart="@dimen/function_sheet_row_padding_h" android:paddingEnd="@dimen/function_sheet_row_padding_h">
                        <ImageView android:layout_width="@dimen/function_sheet_row_icon_size" android:layout_height="@dimen/function_sheet_row_icon_size" android:src="@drawable/lolib_ic_function_print" android:contentDescription="打印"/>
                        <TextView android:textSize="@dimen/function_sheet_row_text_size" android:textColor="#333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="打印" android:layout_marginStart="@dimen/function_sheet_row_icon_text_gap"/>
                </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:id="@+id/function_review_list" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/function_sheet_section_gap" android:layout_marginStart="@dimen/function_sheet_content_margin_h" android:layout_marginEnd="@dimen/function_sheet_content_margin_h">
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/function_action_word_count" android:background="@drawable/lolib_bg_function_sheet_row_bottom_border" android:paddingTop="@dimen/function_sheet_row_padding_v" android:paddingBottom="@dimen/function_sheet_row_padding_v" android:layout_width="match_parent" android:layout_height="@dimen/function_sheet_row_height" android:paddingStart="@dimen/function_sheet_row_padding_h" android:paddingEnd="@dimen/function_sheet_row_padding_h">
                        <ImageView android:layout_width="@dimen/function_sheet_row_icon_size" android:layout_height="@dimen/function_sheet_row_icon_size" android:src="@drawable/lolib_ic_function_word_count" android:contentDescription="字数统计"/>
                        <TextView android:textSize="@dimen/function_sheet_row_text_size" android:textColor="#333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="字数统计" android:layout_marginStart="@dimen/function_sheet_row_icon_text_gap"/>
                </LinearLayout>
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/function_action_find_replace" android:paddingTop="@dimen/function_sheet_row_padding_v" android:paddingBottom="@dimen/function_sheet_row_padding_v" android:layout_width="match_parent" android:layout_height="@dimen/function_sheet_row_height" android:paddingStart="@dimen/function_sheet_row_padding_h" android:paddingEnd="@dimen/function_sheet_row_padding_h">
                        <ImageView android:layout_width="@dimen/function_sheet_row_icon_size" android:layout_height="@dimen/function_sheet_row_icon_size" android:src="@drawable/lolib_ic_function_find_replace" android:contentDescription="查找替换"/>
                        <TextView android:textSize="@dimen/function_sheet_row_text_size" android:textColor="#333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="查找替换" android:layout_marginStart="@dimen/function_sheet_row_icon_text_gap"/>
                </LinearLayout>
        </LinearLayout>
</LinearLayout>
