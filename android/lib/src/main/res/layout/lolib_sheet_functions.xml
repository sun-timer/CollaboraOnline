<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="#ffffff" android:paddingBottom="@dimen/lolib_function_sheet_bottom_pad" android:layout_width="match_parent" android:layout_height="wrap_content">
        <FrameLayout android:layout_width="match_parent" android:layout_height="@dimen/function_sheet_header_height" android:paddingStart="@dimen/function_sheet_header_padding_h" android:paddingEnd="@dimen/function_sheet_header_padding_h">
                <TextView android:textSize="@dimen/function_sheet_title_text_size" android:textColor="#15171a" android:gravity="center" android:layout_width="match_parent" android:layout_height="match_parent" android:text="功能" android:fontFamily="sans-serif-medium"/>
