<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/lolib_bg_ai_model_required_dialog" android:paddingTop="8dp" android:paddingBottom="12dp" android:layout_width="@dimen/ai_model_required_dialog_width" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp">
        <include android:id="@+id/ai_model_required_header" layout="@layout/lolib_include_ai_dialog_header"/>
        <TextView android:textSize="16sp" android:textColor="#333333" android:gravity="center" android:id="@+id/ai_model_required_message" android:paddingTop="@dimen/ai_model_required_content_padding_v" android:paddingBottom="@dimen/ai_model_required_content_padding_v" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="请先在设置中配置基础模型的接口地址" android:lineSpacingExtra="4dp"/>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="@dimen/ai_model_required_button_padding_v" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:textSize="16sp" android:textColor="#333333" android:gravity="center" android:id="@+id/ai_model_required_cancel" android:background="@drawable/lolib_bg_ai_dialog_btn_cancel" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="@dimen/ai_model_required_button_height" android:text="取消" android:layout_weight="1"/>
                <Space android:layout_width="@dimen/ai_model_required_button_gap" android:layout_height="1dp"/>
                <TextView android:textSize="16sp" android:textColor="#ffffff" android:gravity="center" android:id="@+id/ai_model_required_confirm" android:background="@drawable/lolib_bg_ai_dialog_btn_primary" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="@dimen/ai_model_required_button_height" android:text="确定" android:layout_weight="1"/>
        </LinearLayout>
</LinearLayout>
