<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/lolib_bg_dialog_outline"
    android:paddingTop="20dp"
    android:paddingBottom="24dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/ai_model_required_header"
        layout="@layout/lolib_include_ai_dialog_header" />
    <TextView
        android:id="@+id/ai_model_required_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="请先在设置中配置基础模型的接口地址"
        android:textColor="#333333"
        android:textSize="16sp" />
    <LinearLayout
        android:id="@+id/ai_model_required_button_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal" />
</LinearLayout>
