<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/doc_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LOActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/doc_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/doc_top_toolbar_include"
            layout="@layout/lolib_doc_top_toolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <org.libreoffice.androidlib.COWebView
            android:id="@+id/browser"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/doc_bottom_toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/doc_top_toolbar_include" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/ai_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="AI Assistant"
            android:src="@android:drawable/ic_menu_edit"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/doc_bottom_toolbar"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/doc_bottom_toolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/lolib_chrome_toolbar"
            android:elevation="12dp"
            android:gravity="bottom"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Figma 底栏内容区 82dp（164px@2x） -->
            <HorizontalScrollView
                android:id="@+id/doc_bottom_toolbar_content"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lolib_bottom_toolbar_content_height"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/doc_bottom_toolbar_items_row"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp">

                    <LinearLayout
                        android:id="@+id/toolbar_item_mobile_preview"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/toolbar_item_mobile_preview_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/lolib_ic_toolbar_mobile_preview"
                            android:contentDescription="手机预览" />

                        <TextView
                            android:id="@+id/toolbar_item_mobile_preview_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="手机预览"
                            android:textColor="#202124"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/toolbar_item_function"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/lolib_ic_toolbar_function"
                            android:contentDescription="功能" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="功能"
                            android:textColor="#202124"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/toolbar_item_ai_assistant"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/lolib_ic_toolbar_ai_assistant"
                            android:contentDescription="AI助手" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="AI助手"
                            android:textColor="#202124"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/toolbar_item_ai_feature"
                        android:layout_width="100dp"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/lolib_ic_toolbar_ai_feature"
                            android:contentDescription="AI功能" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="AI功能"
                            android:textColor="#202124"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/toolbar_item_keyboard"
                        android:layout_width="100dp"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/lolib_ic_toolbar_keyboard"
                            android:contentDescription="呼出键盘" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="呼出键盘"
                            android:textColor="#202124"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/toolbar_item_character"
                        android:layout_width="92dp"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/lolib_ic_toolbar_character"
                            android:contentDescription="字符" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="字符"
                            android:textColor="#202124"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/toolbar_item_paragraph"
                        android:layout_width="92dp"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/lolib_ic_toolbar_paragraph"
                            android:contentDescription="段落" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="段落"
                            android:textColor="#202124"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/toolbar_item_insert_image"
                        android:layout_width="108dp"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/lolib_ic_toolbar_insert_image"
                            android:contentDescription="插入图片" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="插入图片"
                            android:textColor="#202124"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Calc 编辑模式专属：填充单元格 / 合并单元格 -->
                    <LinearLayout
                        android:id="@+id/toolbar_item_fill_cell"
                        android:layout_width="108dp"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/lolib_ic_toolbar_fill_cell"
                            android:contentDescription="填充单元格" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="填充单元格"
                            android:textColor="#202124"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/toolbar_item_merge_cell"
                        android:layout_width="108dp"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/lolib_ic_toolbar_merge_cell"
                            android:contentDescription="合并单元格" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="合并单元格"
                            android:textColor="#202124"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 三键/手势导航预留区：白底延伸，高度由 BottomToolbarController 注入 -->
            <View
                android:id="@+id/doc_bottom_nav_spacer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@color/lolib_chrome_toolbar"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <View
            android:id="@+id/toolbar_quick_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/doc_bottom_toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/doc_top_toolbar_include" />

        <View
            android:id="@+id/selection_menu_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:elevation="12dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/doc_bottom_toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/doc_top_toolbar_include" />

        <include
            android:id="@+id/selection_popup_panel"
            layout="@layout/lolib_selection_popup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:elevation="14dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/doc_bottom_toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_max="301dp" />

        <View
            android:id="@+id/hyperlink_cell_popup_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:elevation="7dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/doc_bottom_toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/doc_top_toolbar_include" />

        <include
            android:id="@+id/hyperlink_cell_popup_panel"
            layout="@layout/lolib_hyperlink_cell_popup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="8dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/calc_sheet_tab_popup_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:elevation="7dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/doc_bottom_toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/doc_top_toolbar_include" />

        <include
            android:id="@+id/calc_sheet_tab_popup_panel"
            layout="@layout/lolib_calc_sheet_tab_popup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="8dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/impress_slide_thumbnail_popup_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:elevation="7dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/doc_bottom_toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/doc_top_toolbar_include" />

        <include
            android:id="@+id/impress_slide_thumbnail_popup_panel"
            layout="@layout/lolib_impress_slide_thumbnail_popup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="8dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/calc_header_popup_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:elevation="12dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/doc_bottom_toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/doc_top_toolbar_include" />

        <include
            android:id="@+id/calc_header_popup_panel"
            layout="@layout/lolib_calc_header_popup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="14dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/calc_sheet_rename_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:elevation="45dp"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/doc_bottom_toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/doc_top_toolbar_include" />

        <include
            android:id="@+id/calc_sheet_rename_panel"
            layout="@layout/lolib_dialog_calc_sheet_rename"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="50dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Calc 对象（图表/图片/形状）选中底部操作栏 -->
        <include
            android:id="@+id/calc_object_bar_panel"
            layout="@layout/lolib_calc_object_bar"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/doc_bottom_toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0" />

        <!-- AI续写浮层遮罩（点击关闭） -->
        <View
            android:id="@+id/continue_dialog_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#80000000"
            android:clickable="true"
            android:elevation="45dp"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/doc_bottom_toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/doc_top_toolbar_include" />

        <!-- AI续写浮层 panel（尺寸/位置由 LOActivity.positionContinueDialogCenter() 运行时设置） -->
        <include
            android:id="@+id/continue_write_dialog_panel"
            layout="@layout/lolib_continue_write_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="50dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Calc AI公式生成浮层遮罩（点击关闭） -->
        <View
            android:id="@+id/calc_formula_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#80000000"
            android:clickable="true"
            android:elevation="45dp"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Calc AI公式生成浮层 panel（尺寸/位置由 LOActivity.positionCalcFormulaDialogCenter() 运行时设置） -->
        <include
            android:id="@+id/calc_formula_dialog_panel"
            layout="@layout/lolib_calc_formula_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Calc AI条件格式浮层遮罩（点击关闭） -->
        <View
            android:id="@+id/cond_format_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#80000000"
            android:clickable="true"
            android:elevation="45dp"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Calc AI条件格式浮层 panel -->
        <include
            android:id="@+id/cond_format_dialog_panel"
            layout="@layout/lolib_calc_condformat_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Calc AI数据处理浮层遮罩（点击关闭） -->
        <View
            android:id="@+id/dp_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#80000000"
            android:clickable="true"
            android:elevation="45dp"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Calc AI数据处理浮层 panel -->
        <include
            android:id="@+id/dp_dialog_panel"
            layout="@layout/lolib_calc_dataprocess_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- AI图表生成 overlay -->
        <View
            android:id="@+id/chart_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#80000000"
            android:clickable="true"
            android:elevation="45dp"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- AI图表生成弹窗 -->
        <include
            android:id="@+id/chart_dialog_panel"
            layout="@layout/lolib_calc_chart_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- AI生成PPT overlay -->
        <View
            android:id="@+id/impress_outline_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#80000000"
            android:clickable="true"
            android:elevation="45dp"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/doc_main_content"
            app:layout_constraintEnd_toEndOf="@id/doc_main_content"
            app:layout_constraintStart_toStartOf="@id/doc_main_content"
            app:layout_constraintTop_toTopOf="@id/doc_main_content" />

        <!-- AI生成PPT弹窗（尺寸/位置由 LOActivity.positionImpressOutlineDialogCenter() 运行时设置） -->
        <include
            android:id="@+id/impress_outline_panel"
            layout="@layout/lolib_dialog_impress_outline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Calc 新建表格 AI 生成进度浮层遮罩 -->
        <View
            android:id="@+id/calc_new_table_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#80000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Calc 新建表格 AI 生成进度浮层 panel -->
        <LinearLayout
            android:id="@+id/calc_new_table_panel"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:background="@drawable/lolib_bg_dialog_outline"
            android:elevation="50dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ProgressBar
                android:id="@+id/calc_new_table_spinner"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#8A5CFF"
                android:indeterminateTintMode="src_in" />

            <TextView
                android:id="@+id/calc_new_table_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="正在生成表格数据..."
                android:textColor="#202124"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/calc_new_table_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text=""
                android:textColor="#5F6368"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- AI排版结果预览 overlay（含遮罩+卡片，尺寸/位置由 LOActivity.positionTypesetPreviewOverlay() 设置） -->
        <include
            android:id="@+id/typeset_preview_overlay_include"
            layout="@layout/lolib_dialog_typeset_preview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:elevation="48dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/document_tabs_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clickable="true"
            android:elevation="20dp"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/document_tabs_scrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#99000000"
                android:clickable="true"
                android:focusable="true" />

            <include
                android:id="@+id/document_tabs_panel_include"
                layout="@layout/lolib_sheet_document_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/toolbar_quick_panel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/lolib_bg_toolbar_quick_panel"
            android:clickable="true"
            android:elevation="14dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="78dp"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/doc_bottom_toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/toolbar_quick_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <include
            layout="@layout/lolib_mobile_phone_preview_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:elevation="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/doc_top_toolbar_include" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/doc_settings_drawer"
        android:layout_width="356dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#F3F3F3"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/doc_settings_drawer_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:id="@+id/doc_settings_drawer_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/doc_settings_drawer_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="0dp">

            <TextView
                android:id="@+id/doc_settings_clear_cache"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="清理缓存"
                android:textColor="#202124"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/doc_settings_about"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:text="关于"
                android:textColor="#202124"
                android:textSize="18sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
