<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/lolib_bg_dialog_outline" android:paddingTop="20dp" android:paddingBottom="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="24dp" android:paddingEnd="24dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="60dp">
                <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="#1f1f1f" android:gravity="center" android:layout_gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AI 翻译" android:paddingStart="56dp" android:paddingEnd="56dp"/>
                <ImageButton android:layout_gravity="top|end" android:id="@+id/translate_close_btn" android:background="?attr/selectableItemBackgroundBorderless" android:padding="8dp" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginTop="10dp" android:src="@drawable/lolib_ic_dialog_close" android:scaleType="centerInside" android:contentDescription="关闭" android:layout_marginEnd="16dp"/>
        </FrameLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/translate_source_card" android:background="@drawable/lolib_bg_outline_edit" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:paddingStart="12dp" android:paddingEnd="12dp">
                        <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="#333333" android:id="@+id/translate_source_label" android:layout_width="0dp" android:layout_height="wrap_content" android:text="自动识别" android:singleLine="true" android:layout_weight="1"/>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/lolib_ic_arrow_down" android:contentDescription="源语言"/>
                </LinearLayout>
                <ImageButton android:id="@+id/translate_swap_btn" android:background="?attr/selectableItemBackgroundBorderless" android:padding="6dp" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/lolib_ic_btn_swap" android:scaleType="centerInside" android:contentDescription="交换语言" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"/>
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/translate_target_card" android:background="@drawable/lolib_bg_outline_edit" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:paddingStart="12dp" android:paddingEnd="12dp">
                        <TextView android:textSize="14sp" android:textStyle="bold" android:textColor="#1da8ff" android:id="@+id/translate_target_label" android:layout_width="0dp" android:layout_height="wrap_content" android:text="English" android:singleLine="true" android:layout_weight="1"/>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/lolib_ic_arrow_down" android:contentDescription="目标语言"/>
                </LinearLayout>
        </LinearLayout>
        <androidx.core.widget.NestedScrollView android:scrollbarSize="4dp" android:scrollbarThumbVertical="@drawable/lolib_scrollbar_thumb" android:scrollbarStyle="insideOverlay" android:id="@+id/translate_source_scroll" android:background="@drawable/lolib_bg_outline_edit" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="165dp" android:layout_marginTop="12dp" android:fadeScrollbars="false">
                <EditText android:textSize="16sp" android:textColor="#101010" android:textColorHint="#999999" android:gravity="top|start" android:id="@+id/translate_source_edit" android:background="@null" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="145dp" android:hint="请输入或编辑原文" android:inputType="text|textMultiLine|textCapSentences" android:paddingStart="16dp" android:paddingEnd="10dp"/>
        </androidx.core.widget.NestedScrollView>
        <androidx.core.widget.NestedScrollView android:scrollbarSize="4dp" android:scrollbarThumbVertical="@drawable/lolib_scrollbar_thumb" android:scrollbarStyle="insideOverlay" android:id="@+id/translate_result_card" android:background="@drawable/lolib_bg_outline_edit" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="165dp" android:layout_marginTop="12dp" android:fillViewport="true" android:fadeScrollbars="false">
                <TextView android:textSize="16sp" android:textColor="#101010" android:textColorHint="#999999" android:id="@+id/translate_result_text" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="145dp" android:hint="翻译结果" android:lineSpacingExtra="4dp" android:paddingStart="16dp" android:paddingEnd="10dp"/>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout android:gravity="center_vertical" android:layout_gravity="end" android:orientation="horizontal" android:id="@+id/translate_copy_row" android:background="?attr/selectableItemBackground" android:focusable="true" android:visibility="gone" android:clickable="true" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="8dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginEnd="8dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/lolib_ic_copy" android:contentDescription="复制"/>
                <TextView android:textSize="14sp" android:textColor="#6a6a6a" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="复制" android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/translate_generate_btn" android:background="@drawable/lolib_bg_gradient_button_outline" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginTop="12dp" android:paddingStart="20dp" android:paddingEnd="20dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/lolib_ic_btn_generate" android:contentDescription="开始翻译"/>
                <TextView android:textSize="16sp" android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开始翻译" android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:id="@+id/translate_done_row" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <TextView android:textSize="16sp" android:textColor="#e5000000" android:gravity="center" android:id="@+id/translate_regenerate_btn" android:background="@drawable/lolib_bg_outline_secondary_button" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="35dp" android:text="重新生成" android:layout_weight="1" android:layout_marginEnd="8dp"/>
                <TextView android:textSize="16sp" android:textColor="#ffffff" android:gravity="center" android:id="@+id/translate_apply_btn" android:background="@drawable/lolib_bg_gradient_button_outline" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="35dp" android:text="插入文档" android:layout_weight="1" android:layout_marginStart="8dp"/>
        </LinearLayout>
</LinearLayout>
