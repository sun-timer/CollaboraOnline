<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/lolib_bg_dialog_outline" android:paddingTop="20dp" android:paddingBottom="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="24dp" android:paddingEnd="24dp">
        <include layout="@layout/lolib_include_ai_dialog_header"/>
        <TextView android:textSize="13sp" android:textColor="#666666" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="不在词典中"/>
        <TextView android:textSize="15sp" android:textColor="#101010" android:id="@+id/spell_sentence" android:background="@drawable/lolib_bg_function_card_figma" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="56dp" android:lineSpacingExtra="4dp"/>
        <TextView android:textSize="13sp" android:textColor="#666666" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="建议"/>
        <ListView android:id="@+id/spell_suggestions" android:background="@drawable/lolib_bg_function_card_figma" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="8dp" android:divider="#e8e8e8" android:dividerHeight="1dp" android:paddingStart="4dp" android:paddingEnd="4dp"/>
        <TextView android:textSize="14sp" android:textColor="#999999" android:id="@+id/spell_no_suggestions" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="（无建议）"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                <LinearLayout android:gravity="center" android:id="@+id/spell_change_btn" android:background="@drawable/lolib_bg_gradient_button_outline" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="8dp">
                        <TextView android:textSize="15sp" android:textStyle="bold" android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="更正"/>
                </LinearLayout>
                <LinearLayout android:gravity="center" android:id="@+id/spell_change_all_btn" android:background="@drawable/lolib_bg_outline_secondary_button" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1">
                        <TextView android:textSize="15sp" android:textColor="#333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="全部更正"/>
                </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <LinearLayout android:gravity="center" android:id="@+id/spell_ignore_btn" android:background="@drawable/lolib_bg_outline_secondary_button" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="8dp">
                        <TextView android:textSize="15sp" android:textColor="#333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="忽略"/>
                </LinearLayout>
                <LinearLayout android:gravity="center" android:id="@+id/spell_ignore_all_btn" android:background="@drawable/lolib_bg_outline_secondary_button" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1">
                        <TextView android:textSize="15sp" android:textColor="#333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="全部忽略"/>
                </LinearLayout>
        </LinearLayout>
        <LinearLayout android:gravity="center" android:id="@+id/spell_add_dict_btn" android:background="@drawable/lolib_bg_outline_secondary_button" android:focusable="true" android:visibility="gone" android:clickable="true" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp">
                <TextView android:textSize="15sp" android:textColor="#333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="添加到词典"/>
        </LinearLayout>
        <LinearLayout android:gravity="center" android:id="@+id/spell_close_btn" android:background="@drawable/lolib_bg_outline_secondary_button" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp">
                <TextView android:textSize="17sp" android:textColor="#333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="关闭"/>
        </LinearLayout>
</LinearLayout>
