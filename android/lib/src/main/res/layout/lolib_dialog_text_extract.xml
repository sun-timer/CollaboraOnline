<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/lolib_bg_dialog_outline" android:paddingTop="20dp" android:paddingBottom="24dp" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="24dp" android:paddingEnd="24dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="#1f1f1f" android:gravity="center" android:id="@+id/text_extract_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="文字提取"/>
                <ImageButton android:layout_gravity="top|end" android:id="@+id/text_extract_close_btn" android:background="?attr/selectableItemBackgroundBorderless" android:padding="8dp" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginTop="10dp" android:src="@drawable/lolib_ic_dialog_close" android:scaleType="centerInside" android:contentDescription="关闭" android:layout_marginEnd="16dp"/>
        </FrameLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/text_extract_input_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="16dp" android:layout_weight="1">
                <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/text_extract_album_btn" android:background="@drawable/lolib_bg_outline_edit" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1" android:layout_marginEnd="12dp">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/lolib_ic_ai_image_generate" android:contentDescription="相册导入"/>
                        <TextView android:textSize="16sp" android:textColor="#333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="相册导入"/>
                </LinearLayout>
                <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/text_extract_camera_btn" android:background="@drawable/lolib_bg_outline_edit" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="120dp" android:layout_weight="1" android:layout_marginStart="12dp">
                        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@android:drawable/ic_menu_camera" android:contentDescription="拍照识别"/>
                        <TextView android:textSize="16sp" android:textColor="#333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="拍照识别"/>
                </LinearLayout>
        </LinearLayout>
        <androidx.core.widget.NestedScrollView android:scrollbarStyle="0x00000000" android:id="@+id/text_extract_result_card" android:background="@drawable/lolib_bg_outline_edit" android:visibility="gone" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="16dp" android:fillViewport="true" android:layout_weight="1" android:fadeScrollbars="false">
                <TextView android:textSize="16sp" android:textColor="#333333" android:id="@+id/text_extract_result_text" android:paddingTop="16dp" android:paddingBottom="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="正在识别..." android:lineSpacingExtra="4dp" android:paddingStart="20dp" android:paddingEnd="20dp"/>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/text_extract_copy_row" android:background="?attr/selectableItemBackground" android:focusable="true" android:visibility="gone" android:clickable="true" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="12dp">
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/lolib_ic_copy" android:contentDescription="复制"/>
                <TextView android:textSize="16sp" android:textColor="#6a6a6a" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="复制" android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:id="@+id/text_extract_done_row" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/text_extract_re_recognize_btn" android:background="@drawable/lolib_bg_outline_secondary_button" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginEnd="12dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/lolib_ic_btn_regenerate" android:contentDescription="重新识别"/>
                        <TextView android:textSize="18sp" android:textColor="#333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="重新识别" android:layout_marginStart="8dp"/>
                </LinearLayout>
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/text_extract_apply_btn" android:background="@drawable/lolib_bg_gradient_button_outline" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginStart="12dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/lolib_ic_btn_insert" android:contentDescription="插入文档"/>
                        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="插入文档" android:layout_marginStart="8dp"/>
                </LinearLayout>
        </LinearLayout>
</LinearLayout>
