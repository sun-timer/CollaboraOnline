<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/lolib_bg_dialog_outline" android:paddingTop="20dp" android:paddingBottom="24dp" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="24dp" android:paddingEnd="24dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:textSize="20sp" android:textStyle="0x00000001" android:textColor="#1f1f1f" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="文案生成"/>
                <ImageButton android:layout_gravity="top|end" android:id="@+id/article_close_btn" android:background="?attr/selectableItemBackgroundBorderless" android:padding="8dp" android:layout_width="42dp" android:layout_height="42dp" android:src="@android:drawable/ic_menu_close_clear_cancel" android:contentDescription="关闭"/>
        </FrameLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/article_category_card" android:background="@drawable/lolib_bg_outline_edit" android:paddingTop="16dp" android:paddingBottom="16dp" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:minHeight="64dp" android:paddingStart="20dp" android:paddingEnd="20dp">
                <TextView android:textSize="16sp" android:textStyle="0x00000001" android:textColor="#333333" android:id="@+id/article_category_label" android:layout_width="0dp" android:layout_height="wrap_content" android:text="请选择分类" android:layout_weight="1"/>
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/lolib_ic_arrow_down" android:contentDescription="选择分类"/>
        </LinearLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/article_subtype_card" android:background="@drawable/lolib_bg_outline_edit" android:paddingTop="16dp" android:paddingBottom="16dp" android:focusable="true" android:visibility="gone" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="64dp" android:paddingStart="20dp" android:paddingEnd="20dp">
                <TextView android:textSize="16sp" android:textStyle="0x00000001" android:textColor="#333333" android:id="@+id/article_subtype_label" android:layout_width="0dp" android:layout_height="wrap_content" android:text="请选择子类" android:layout_weight="1"/>
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/lolib_ic_arrow_down" android:contentDescription="选择子类"/>
        </LinearLayout>
        <TextView android:textSize="16sp" android:textColor="#999999" android:gravity="center" android:id="@+id/article_stage_hint" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="24dp" android:text="请选择文案类型后，进行文案生成" android:layout_weight="1"/>
        <LinearLayout android:orientation="vertical" android:id="@+id/article_stage_form" android:visibility="gone" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="16dp" android:layout_weight="1">
                <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:fillViewport="true" android:layout_weight="1">
                        <LinearLayout android:orientation="vertical" android:id="@+id/article_form_container" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </androidx.core.widget.NestedScrollView>
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/article_generate_btn" android:background="@drawable/lolib_bg_gradient_button_outline" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/lolib_ic_btn_generate" android:contentDescription="开始生成"/>
                        <TextView android:textSize="18sp" android:textStyle="0x00000001" android:textColor="#ffffff" android:id="@+id/article_generate_btn_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开始生成" android:layout_marginStart="8dp"/>
                </LinearLayout>
        </LinearLayout>
        <androidx.core.widget.NestedScrollView android:scrollbarStyle="0x00000000" android:id="@+id/article_result_card" android:background="@drawable/lolib_bg_outline_edit" android:visibility="gone" android:scrollbars="0x00000200" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="16dp" android:fillViewport="true" android:layout_weight="1" android:fadeScrollbars="false">
                <TextView android:textSize="16sp" android:textColor="#333333" android:id="@+id/article_result_text" android:paddingTop="16dp" android:paddingBottom="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="正在生成文案..." android:lineSpacingExtra="4dp" android:paddingStart="20dp" android:paddingEnd="20dp"/>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/article_copy_row" android:background="?attr/selectableItemBackground" android:focusable="true" android:visibility="gone" android:clickable="true" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="12dp">
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/lolib_ic_copy" android:contentDescription="复制"/>
                <TextView android:textSize="16sp" android:textColor="#6a6a6a" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="复制" android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:id="@+id/article_done_row" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/article_regenerate_btn" android:background="@drawable/lolib_bg_outline_secondary_button" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginEnd="12dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/lolib_ic_btn_regenerate" android:contentDescription="重新生成"/>
                        <TextView android:textSize="18sp" android:textColor="#333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="重新生成" android:layout_marginStart="8dp"/>
                </LinearLayout>
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/article_apply_btn" android:background="@drawable/lolib_bg_gradient_button_outline" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginStart="12dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/lolib_ic_btn_insert" android:contentDescription="插入文档"/>
                        <TextView android:textSize="18sp" android:textStyle="0x00000001" android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="插入文档" android:layout_marginStart="8dp"/>
                </LinearLayout>
        </LinearLayout>
</LinearLayout>
