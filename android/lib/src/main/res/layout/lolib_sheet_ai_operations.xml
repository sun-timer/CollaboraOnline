<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/lolib_bg_ai_sheet_container"
    android:orientation="vertical">

    <!-- 顶栏：全宽渐变，图标+标题居中 -->
    <include
        android:id="@+id/ai_op_header"
        layout="@layout/lolib_include_ai_sheet_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:descendantFocusability="blocksDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- ============== Selection hint ============== -->
        <TextView
            android:id="@+id/ai_op_selection_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#E6EBF2"
            android:gravity="center"
            android:padding="10dp"
            android:text="请先在文档中选择文本"
            android:textColor="#5F6368"
            android:textSize="14sp" />

        <!-- ============== Section: Calc AI（整块仅在 Calc 文档显示） ============== -->
        <LinearLayout
            android:id="@+id/ai_op_calc_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

        <LinearLayout
            android:id="@+id/ai_op_calc_section_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- AI公式 -->
            <LinearLayout
                android:id="@+id/ai_op_calc_formula"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/lolib_bg_ai_function_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="AI公式"
                    android:scaleType="centerInside"
                    android:src="@drawable/lolib_ic_ai_calc_formula" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="AI公式"
                    android:textColor="#101010"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- AI条件格式 -->
            <LinearLayout
                android:id="@+id/ai_op_calc_cond_format"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/lolib_bg_ai_function_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="AI条件格式"
                    android:scaleType="centerInside"
                    android:src="@drawable/lolib_ic_ai_calc_cond_format" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="AI条件格式"
                    android:textColor="#101010"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- AI数据分析 -->
            <LinearLayout
                android:id="@+id/ai_op_calc_data_analysis"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:background="@drawable/lolib_bg_ai_function_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="AI数据分析"
                    android:scaleType="centerInside"
                    android:src="@drawable/lolib_ic_ai_calc_data_analysis" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="AI数据分析"
                    android:textColor="#101010"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- AI数据处理 + AI图表生成（第二行 2 列，第三列由运行时补齐占位） -->
        <LinearLayout
            android:id="@+id/ai_op_calc_section_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/ai_op_calc_data_process"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/lolib_bg_ai_function_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="AI数据处理"
                    android:scaleType="centerInside"
                    android:src="@drawable/lolib_ic_ai_calc_data_process" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="AI数据处理"
                    android:textColor="#101010"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ai_op_calc_chart"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/lolib_bg_ai_function_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="AI图表生成"
                    android:scaleType="centerInside"
                    android:src="@drawable/lolib_ic_ai_calc_chart_generate" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="AI图表生成"
                    android:textColor="#101010"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        </LinearLayout>

        <!-- ============== Section: Impress AI（整块仅在 Impress 文档显示） ============== -->
        <LinearLayout
            android:id="@+id/ai_op_impress_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="演示文稿"
                android:textColor="#101010"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/ai_op_impress_ppt"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/lolib_bg_ai_function_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="AI生成PPT"
                        android:scaleType="centerInside"
                        android:src="@drawable/lolib_ic_ai_chart_generate" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="AI生成PPT"
                        android:textColor="#101010"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- 占位 -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============== Section: 文案生成 (3 按钮) ============== -->
        <TextView
            android:id="@+id/ai_op_writer_section_1_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="文案生成"
            android:textColor="#101010"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/ai_op_writer_section_1_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- AI续写 -->
            <LinearLayout
                android:id="@+id/ai_op_continue_write"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/lolib_bg_ai_function_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="AI续写"
                    android:scaleType="centerInside"
                    android:src="@drawable/lolib_ic_ai_continue_write" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="AI续写"
                    android:textColor="#101010"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 生成大纲 -->
            <LinearLayout
                android:id="@+id/ai_op_outline"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/lolib_bg_ai_function_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="生成大纲"
                    android:scaleType="centerInside"
                    android:src="@drawable/lolib_ic_ai_outline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="生成大纲"
                    android:textColor="#101010"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 文案生成 -->
            <LinearLayout
                android:id="@+id/ai_op_article_generate"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:background="@drawable/lolib_bg_ai_function_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="文案生成"
                    android:scaleType="centerInside"
                    android:src="@drawable/lolib_ic_ai_article_generate" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="文案生成"
                    android:textColor="#101010"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============== Section: 文案处理 (5 按钮) ============== -->
        <TextView
            android:id="@+id/ai_op_writer_section_2_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="文案处理"
            android:textColor="#101010"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/ai_op_writer_section_2_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- 文案润色 -->
            <LinearLayout
                android:id="@+id/ai_op_polish"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/lolib_bg_ai_function_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="文案润色"
                    android:scaleType="centerInside"
                    android:src="@drawable/lolib_ic_ai_polish" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="文案润色"
                    android:textColor="#101010"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 文案扩写 -->
            <LinearLayout
                android:id="@+id/ai_op_expand"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/lolib_bg_ai_function_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="文案扩写"
                    android:scaleType="centerInside"
                    android:src="@drawable/lolib_ic_ai_expand" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="文案扩写"
                    android:textColor="#101010"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 文案缩写 -->
            <LinearLayout
                android:id="@+id/ai_op_condense"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:background="@drawable/lolib_bg_ai_function_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="文案缩写"
                    android:scaleType="centerInside"
                    android:src="@drawable/lolib_ic_ai_condense" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="文案缩写"
                    android:textColor="#101010"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ai_op_writer_section_2_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- 文案重写 -->
            <LinearLayout
                android:id="@+id/ai_op_rewrite"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/lolib_bg_ai_function_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="文案重写"
                    android:scaleType="centerInside"
                    android:src="@drawable/lolib_ic_ai_rewrite" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="文案重写"
                    android:textColor="#101010"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 文案翻译 -->
            <LinearLayout
                android:id="@+id/ai_op_translate"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/lolib_bg_ai_function_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="文案翻译"
                    android:scaleType="centerInside"
                    android:src="@drawable/lolib_ic_ai_translate" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="文案翻译"
                    android:textColor="#101010"
                    android:textSize="14sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- ============== Section: 其他 ============== -->
        <TextView
            android:id="@+id/ai_op_other_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="其他"
            android:textColor="#101010"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/ai_op_other_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- 文字提取 -->
            <LinearLayout
                android:id="@+id/ai_op_text_extract"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/lolib_bg_ai_function_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="文字提取"
                    android:scaleType="centerInside"
                    android:src="@drawable/lolib_ic_ai_text_extract" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="文字提取"
                    android:textColor="#101010"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- AI排版 -->
            <LinearLayout
                android:id="@+id/ai_op_typeset"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/lolib_bg_ai_function_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="AI排版"
                    android:scaleType="centerInside"
                    android:src="@drawable/lolib_ic_ai_typeset" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="AI排版"
                    android:textColor="#101010"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- AI图片 -->
            <LinearLayout
                android:id="@+id/ai_op_image_generate"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:background="@drawable/lolib_bg_ai_function_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="AI图片"
                    android:scaleType="centerInside"
                    android:src="@drawable/lolib_ic_ai_image_generate" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="AI图片"
                    android:textColor="#101010"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ai_op_other_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- 格式批量处理 -->
            <LinearLayout
                android:id="@+id/ai_op_format_batch"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/lolib_bg_ai_function_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="格式批量处理"
                    android:scaleType="centerInside"
                    android:src="@drawable/lolib_ic_ai_format_batch" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="格式批量处理"
                    android:textColor="#101010"
                    android:textSize="14sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="2" />
        </LinearLayout>

        <!-- ============== Loading bar ============== -->
        <LinearLayout
            android:id="@+id/ai_op_loading_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/ai_op_spinner"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminate="true"
                android:indeterminateTint="#1E88E5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="AI 正在生成..."
                android:textColor="#5F6368"
                android:textSize="14sp" />

            <Button
                android:id="@+id/ai_op_cancel"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="16dp"
                android:background="@android:color/transparent"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="取消"
                android:textColor="#E53935"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
