<?xml version="1.0" encoding="utf-8"?>
<!-- Selection popup — Figma 245:7964 (AI Office 平板 2026/8/10)
     Row1: 复制/剪切/粘贴/全选/翻译
     Row2: AI 操作 ×5
     Row3: AI 操作 ×2 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/selection_popup_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/lolib_bg_selection_popup"
    android:clickable="true"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Row 1: 基础操作（Figma frame-3468910, h≈56dp） -->
    <LinearLayout
        android:id="@+id/selection_basic_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/selection_op_copy"
            style="@style/SelectionPopupButtonWeighted">

            <ImageView
                style="@style/SelectionPopupButtonIcon"
                android:src="@drawable/lolib_ic_selection_copy" />

            <TextView
                style="@style/SelectionPopupButtonText"
                android:text="复制" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selection_op_cut"
            style="@style/SelectionPopupButtonWeighted">

            <ImageView
                style="@style/SelectionPopupButtonIcon"
                android:src="@drawable/lolib_ic_selection_cut" />

            <TextView
                style="@style/SelectionPopupButtonText"
                android:text="剪切" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selection_op_paste"
            style="@style/SelectionPopupButtonWeighted">

            <ImageView
                style="@style/SelectionPopupButtonIcon"
                android:src="@drawable/lolib_ic_selection_paste" />

            <TextView
                style="@style/SelectionPopupButtonText"
                android:text="粘贴" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selection_op_select_all"
            style="@style/SelectionPopupButtonWeighted">

            <ImageView
                style="@style/SelectionPopupButtonIcon"
                android:src="@drawable/lolib_ic_selection_select_all" />

            <TextView
                style="@style/SelectionPopupButtonText"
                android:text="全选" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selection_op_delete"
            style="@style/SelectionPopupButton"
            android:visibility="gone">

            <ImageView
                style="@style/SelectionPopupButtonIcon"
                android:src="@drawable/lolib_ic_selection_delete" />

            <TextView
                style="@style/SelectionPopupButtonText"
                android:text="删除" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selection_op_image_edit"
            style="@style/SelectionPopupButton"
            android:visibility="gone">

            <ImageView
                style="@style/SelectionPopupButtonIcon"
                android:src="@drawable/lolib_ic_impress_insert_local_image" />

            <TextView
                style="@style/SelectionPopupButtonText"
                android:text="图片编辑" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selection_op_save"
            style="@style/SelectionPopupButton"
            android:visibility="gone">

            <ImageView
                style="@style/SelectionPopupButtonIcon"
                android:src="@drawable/lolib_ic_impress_file_save_as" />

            <TextView
                style="@style/SelectionPopupButtonText"
                android:text="保存" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selection_op_translate"
            style="@style/SelectionPopupButtonWeighted">

            <ImageView
                style="@style/SelectionPopupButtonIcon"
                android:src="@drawable/lolib_ic_ai_translate" />

            <TextView
                style="@style/SelectionPopupButtonText"
                android:text="翻译" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/selection_divider_1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/lolib_bg_selection_popup_row_divider" />

    <!-- Row 2: AI 操作 (Figma frame-3468911, h≈60dp) -->
    <LinearLayout
        android:id="@+id/selection_ai_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/selection_op_outline"
            style="@style/SelectionPopupButtonWeighted">

            <ImageView
                style="@style/SelectionPopupButtonIcon"
                android:src="@drawable/lolib_ic_ai_outline" />

            <TextView
                style="@style/SelectionPopupButtonText"
                android:text="总结大纲" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selection_op_continue_write"
            style="@style/SelectionPopupButtonWeighted">

            <ImageView
                style="@style/SelectionPopupButtonIcon"
                android:src="@drawable/lolib_ic_ai_continue_write" />

            <TextView
                style="@style/SelectionPopupButtonText"
                android:text="文案续写" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selection_op_article_generate"
            style="@style/SelectionPopupButtonWeighted">

            <ImageView
                style="@style/SelectionPopupButtonIcon"
                android:src="@drawable/lolib_ic_ai_article_generate" />

            <TextView
                style="@style/SelectionPopupButtonText"
                android:text="文案生成" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selection_op_expand"
            style="@style/SelectionPopupButtonWeighted">

            <ImageView
                style="@style/SelectionPopupButtonIcon"
                android:src="@drawable/lolib_ic_ai_expand" />

            <TextView
                style="@style/SelectionPopupButtonText"
                android:text="文案扩写" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selection_op_polish"
            style="@style/SelectionPopupButtonWeighted">

            <ImageView
                style="@style/SelectionPopupButtonIcon"
                android:src="@drawable/lolib_ic_ai_polish" />

            <TextView
                style="@style/SelectionPopupButtonText"
                android:text="文案润色" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/selection_divider_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/lolib_bg_selection_popup_row_divider" />

    <!-- Row 3: AI 操作 (Figma frame-3468912, h≈56dp) -->
    <LinearLayout
        android:id="@+id/selection_ai_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/selection_op_condense"
            style="@style/SelectionPopupButtonWeighted">

            <ImageView
                style="@style/SelectionPopupButtonIcon"
                android:src="@drawable/lolib_ic_ai_condense" />

            <TextView
                style="@style/SelectionPopupButtonText"
                android:text="文案缩写" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selection_op_rewrite"
            style="@style/SelectionPopupButtonWeighted">

            <ImageView
                style="@style/SelectionPopupButtonIcon"
                android:src="@drawable/lolib_ic_ai_rewrite" />

            <TextView
                style="@style/SelectionPopupButtonText"
                android:text="文案重写" />
        </LinearLayout>

        <!-- 占位：与上行五列对齐，右侧空出 3 格 -->
        <View
            android:id="@+id/selection_ai_row_2_spacer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
