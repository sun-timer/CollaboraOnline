<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="18dp">

    <FrameLayout
        android:id="@+id/function_edit_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="功能"
            android:textColor="#15171A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/function_edit_sheet_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/lolib_ic_dialog_close" />
    </FrameLayout>

    <!-- Tab bar area: HorizontalScrollView for tabs + indicator + border -->
    <FrameLayout
        android:id="@+id/function_edit_tab_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/function_edit_tab_bar"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Blue indicator line (positioned programmatically) -->
        <View
            android:id="@+id/function_edit_tab_indicator"
            android:layout_width="24dp"
            android:layout_height="3dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="1dp"
            android:background="#1278D9"
            android:visibility="invisible" />

        <!-- Bottom border -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:background="#A2A9B2" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/function_edit_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fillViewport="true" />

    <include
        android:id="@+id/function_font_picker_panel"
        layout="@layout/lolib_sheet_font_picker"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

</LinearLayout>
