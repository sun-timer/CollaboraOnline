<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/impress_outline_card_page_label"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:textColor="#999999"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/impress_outline_card_expand"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="展开"
            android:padding="2dp"
            android:scaleType="centerInside"
            android:src="@drawable/lolib_ic_chevron_right"
            android:visibility="gone" />

        <EditText
            android:id="@+id/impress_outline_card_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/impress_ppt_slide_title_hint"
            android:inputType="text"
            android:padding="0dp"
            android:textColor="#101010"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/impress_outline_card_type_tag"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/lolib_bg_impress_outline_type_tag"
            android:drawableEnd="@drawable/lolib_ic_chevron_down"
            android:drawablePadding="2dp"
            android:gravity="center_vertical"
            android:minWidth="52dp"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:textColor="#666666"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/impress_outline_card_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="8dp"
        android:background="@null"
        android:gravity="start|top"
        android:hint="@string/impress_ppt_slide_content_hint"
        android:inputType="textMultiLine"
        android:lineSpacingExtra="4dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:textColor="#666666"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
