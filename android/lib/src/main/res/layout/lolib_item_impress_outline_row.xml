<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:textSize="14sp" android:textColor="#999999" android:id="@+id/impress_outline_card_page_label" android:layout_width="36dp" android:layout_height="wrap_content"/>
                <ImageView android:id="@+id/impress_outline_card_expand" android:padding="2dp" android:visibility="gone" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/lolib_ic_chevron_right" android:scaleType="centerInside" android:contentDescription="展开" android:layout_marginEnd="4dp"/>
                <EditText android:textSize="15sp" android:textStyle="bold" android:textColor="#101010" android:id="@+id/impress_outline_card_title" android:background="@null" android:padding="0dp" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="@string/impress_ppt_slide_title_hint" android:layout_weight="1" android:inputType="text"/>
                <TextView android:textSize="12sp" android:textColor="#666666" android:gravity="center" android:id="@+id/impress_outline_card_type_tag" android:background="@drawable/lolib_bg_impress_outline_type_tag" android:layout_width="wrap_content" android:layout_height="28dp" android:minWidth="52dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_marginStart="8dp"/>
        </LinearLayout>
        <EditText android:textSize="13sp" android:textColor="#666666" android:gravity="start|top" android:id="@+id/impress_outline_card_content" android:background="@null" android:padding="0dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="0dp" android:hint="@string/impress_ppt_slide_content_hint" android:lineSpacingExtra="4dp" android:inputType="text|textMultiLine" android:layout_marginStart="56dp"/>
</LinearLayout>
