<?xml version="1.0" encoding="utf-8"?>
<!-- AI 功能弹窗顶栏：Figma 750×124，padding 30/24，居中标题 + 右侧关闭 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ai_sheet_header_height"
    android:background="@drawable/lolib_bg_ai_sheet_header"
    android:paddingStart="@dimen/ai_sheet_header_padding_h"
    android:paddingTop="@dimen/ai_sheet_header_padding_v"
    android:paddingEnd="@dimen/ai_sheet_header_padding_h"
    android:paddingBottom="@dimen/ai_sheet_header_padding_v">

    <LinearLayout
        android:id="@+id/ai_sheet_header_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ai_sheet_header_icon"
            android:layout_width="@dimen/ai_sheet_header_icon_size"
            android:layout_height="@dimen/ai_sheet_header_icon_size"
            android:contentDescription="AI"
            android:src="@drawable/lolib_ic_ai_ops_sparkle" />

        <TextView
            android:id="@+id/ai_sheet_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="AI功能"
            android:textColor="#101010"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/ai_sheet_header_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="end|center_vertical"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="关闭"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/lolib_ic_dialog_close" />
</FrameLayout>
