<?xml version="1.0" encoding="utf-8"?>
<!-- Calc AI条件格式生成弹窗 panel：三态（输入态/生成中态/完成态）。
     尺寸由 LOActivity.positionCondFormatDialogCenter() 运行时覆写。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cond_format_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lolib_bg_continue_dialog"
    android:elevation="50dp"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- ========== 标题栏 ========== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/cond_format_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="AI条件格式"
            android:textColor="#15171A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/cond_format_close_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="关闭"
            android:focusable="true"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </FrameLayout>

    <!-- ========== 选中范围提示 ========== -->
    <TextView
        android:id="@+id/cond_format_range_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#5F6368"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- ========== 输入区（输入态可见） ========== -->
    <LinearLayout
        android:id="@+id/cond_format_input_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="visible">

        <EditText
            android:id="@+id/cond_format_input"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/lolib_bg_continue_dialog"
            android:gravity="top|start"
            android:hint="请输入条件格式需求，例如：&#10;&#34;高亮大于100的单元格为红色&#34;"
            android:inputType="textMultiLine"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:textColor="#15171A"
            android:textColorHint="#9AA0A6"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/cond_format_generate_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/lolib_bg_continue_pill_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="AI生成规则"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- ========== 内容卡片（生成中态/完成态可见） ========== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/cond_format_content_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cond_format_user_input_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F0F2F5"
                android:padding="10dp"
                android:text=""
                android:textColor="#5F6368"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/cond_format_content_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="top"
                android:lineSpacingExtra="4dp"
                android:text=""
                android:textColor="#15171A"
                android:textColorHint="#9AA0A6"
                android:textSize="15sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ========== 复制栏（完成态显示） ========== -->
    <LinearLayout
        android:id="@+id/cond_format_copy_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="复制规则"
            android:src="@drawable/lolib_ic_continue_copy" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="复制规则"
            android:textColor="#6A6A6A"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- ========== 生成中态：停止按钮 ========== -->
    <FrameLayout
        android:id="@+id/cond_format_stop_button"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/lolib_bg_continue_stop_button"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="停止生成"
            android:src="@drawable/lolib_ic_continue_stop" />
    </FrameLayout>

    <!-- ========== 完成态：重新生成 + 应用格式 + 复制规则 ========== -->
    <LinearLayout
        android:id="@+id/cond_format_completed_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/cond_format_regenerate_button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:background="@drawable/lolib_bg_continue_pill_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="重新生成"
            android:textColor="#15171A"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/cond_format_apply_button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@drawable/lolib_bg_continue_pill_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="应用格式"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>
