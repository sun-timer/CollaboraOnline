<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/calc_formula_dialog_root" android:background="@drawable/lolib_bg_continue_dialog" android:paddingBottom="8dp" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:elevation="50dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="16dp" android:paddingEnd="16dp">
                <TextView android:textSize="20sp" android:textStyle="normal" android:textColor="#1f1f1f" android:gravity="center" android:layout_gravity="center" android:id="@+id/calc_formula_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AI公式"/>
                <ImageButton android:layout_gravity="center" android:id="@+id/calc_formula_close_button" android:background="?attr/selectableItemBackgroundBorderless" android:padding="0dp" android:focusable="true" android:clickable="true" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/lolib_ic_dialog_close" android:scaleType="centerInside" android:contentDescription="关闭"/>
        </FrameLayout>
        <TextView android:textSize="14sp" android:textColor="#5f6368" android:id="@+id/calc_formula_cell_hint" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:paddingStart="20dp" android:paddingEnd="20dp"/>
        <LinearLayout android:orientation="vertical" android:id="@+id/calc_formula_input_group" android:paddingBottom="20dp" android:visibility="visible" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp">
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/lolib_bg_calc_formula_input" android:layout_width="match_parent" android:layout_height="43dp" android:paddingStart="5dp" android:paddingEnd="5dp">
                        <View android:background="#101010" android:layout_width="2dp" android:layout_height="19dp"/>
                        <EditText android:textSize="16sp" android:textColor="#101010" android:textColorHint="#cccccc" android:gravity="center" android:id="@+id/calc_formula_input" android:background="@android:color/transparent" android:layout_width="0dp" android:layout_height="match_parent" android:hint="AI生成公式" android:maxLines="1" android:singleLine="true" android:layout_weight="1" android:inputType="text" android:layout_marginStart="5dp"/>
                </LinearLayout>
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/calc_formula_generate_btn" android:background="@drawable/lolib_bg_continue_pill_primary" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginTop="16dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/lolib_ic_btn_generate" android:contentDescription="开始生成"/>
                        <TextView android:textSize="16sp" android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开始生成" android:layout_marginStart="4dp"/>
                </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:id="@+id/calc_formula_work_group" android:paddingTop="12dp" android:paddingBottom="12dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="12dp">
                <FrameLayout android:background="@drawable/lolib_bg_calc_formula_input" android:layout_width="match_parent" android:layout_height="43dp">
                        <TextView android:textSize="16sp" android:textColor="#999999" android:ellipsize="3" android:gravity="center" android:id="@+id/calc_formula_query_text" android:layout_width="match_parent" android:layout_height="match_parent" android:text="" android:maxLines="1" android:paddingStart="10dp" android:paddingEnd="10dp"/>
                </FrameLayout>
                <LinearLayout android:gravity="start" android:orientation="vertical" android:id="@+id/calc_formula_status_row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                        <TextView android:textSize="14sp" android:id="@+id/calc_formula_status_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="公式生成中"/>
                        <ProgressBar android:id="@+id/calc_formula_status_spinner" android:visibility="gone" android:layout_width="16dp" android:layout_height="16dp" android:layout_marginTop="8dp" android:indeterminate="true" android:indeterminateTint="#333333"/>
                </LinearLayout>
                <TextView android:textSize="16sp" android:textColor="#333333" android:gravity="top|start" android:id="@+id/calc_formula_content_text" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="" android:lineSpacingExtra="2dp"/>
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/calc_formula_stop_group" android:background="@drawable/lolib_bg_calc_formula_stop_pill" android:focusable="true" android:visibility="gone" android:clickable="true" android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginBottom="20dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
                <FrameLayout android:background="@drawable/lolib_bg_calc_formula_stop_icon" android:layout_width="20dp" android:layout_height="20dp">
                        <ImageView android:layout_gravity="center" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/lolib_ic_continue_stop" android:contentDescription="停止生成"/>
                </FrameLayout>
                <TextView android:textSize="16sp" android:textColor="#fe3a3a" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="停止生成" android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/calc_formula_restart_group" android:background="@drawable/lolib_bg_continue_pill_primary" android:focusable="true" android:visibility="gone" android:clickable="true" android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginBottom="20dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/lolib_ic_btn_generate" android:contentDescription="开始生成"/>
                <TextView android:textSize="16sp" android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开始生成" android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:id="@+id/calc_formula_completed_group" android:paddingTop="12dp" android:paddingBottom="24dp" android:visibility="gone" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp">
                <TextView android:textSize="16sp" android:textColor="#e6000000" android:gravity="center" android:id="@+id/calc_formula_regenerate_button" android:background="@drawable/lolib_bg_continue_pill_secondary_35" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="35dp" android:minHeight="35dp" android:text="重新生成" android:includeFontPadding="false" android:layout_weight="1" android:layout_marginEnd="8dp"/>
                <TextView android:textSize="16sp" android:textColor="#ffffff" android:gravity="center" android:id="@+id/calc_formula_insert_button" android:background="@drawable/lolib_bg_continue_pill_primary_35" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="35dp" android:minHeight="35dp" android:text="插入单元格" android:includeFontPadding="false" android:layout_weight="1" android:layout_marginStart="8dp"/>
        </LinearLayout>
</LinearLayout>
