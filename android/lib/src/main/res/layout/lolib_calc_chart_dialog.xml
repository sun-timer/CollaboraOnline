<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chart_dialog_root"
    android:layout_width="328dp"
    android:layout_height="560dp"
    android:background="@drawable/lolib_bg_continue_dialog"
    android:elevation="50dp"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- ========== 标题栏 ========== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/chart_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="AI图表生成"
            android:textColor="#15171A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/chart_close_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="关闭"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </FrameLayout>

    <!-- ========== 选中区域提示 ========== -->
    <TextView
        android:id="@+id/chart_range_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#5F6368"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- ========== 输入区（输入态可见） ========== -->
    <LinearLayout
        android:id="@+id/chart_input_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="visible">

        <EditText
            android:id="@+id/chart_input"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/lolib_bg_continue_dialog"
            android:gravity="top|start"
            android:hint="输入想要计算的AI图表"
            android:inputType="textMultiLine"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:textColor="#15171A"
            android:textColorHint="#9AA0A6"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/chart_generate_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/lolib_bg_continue_pill_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✨ 开始生成"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- ========== 生成中态：加载文字（生成中态可见） ========== -->
    <TextView
        android:id="@+id/chart_loading_status"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="正在生成AI图表..."
        android:textColor="#8A5CFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- ========== 生成中态：停止按钮 ========== -->
    <FrameLayout
        android:id="@+id/chart_stop_button"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/lolib_bg_continue_stop_button"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="停止生成"
            android:src="@drawable/lolib_ic_continue_stop" />
    </FrameLayout>

    <!-- ========== 完成态：AI建议文本（完成态可见） ========== -->
    <LinearLayout
        android:id="@+id/chart_completed_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/chart_result_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="top|start"
            android:lineSpacingExtra="4dp"
            android:text=""
            android:textColor="#15171A"
            android:textSize="15sp" />

        <!-- 重新生成 + 插入图表 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chart_regenerate_btn"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/lolib_bg_continue_pill_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="重新生成"
                android:textColor="#15171A"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/chart_insert_btn"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@drawable/lolib_bg_continue_pill_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="插入图表"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========== 执行中态：进度文字 ========== -->
    <TextView
        android:id="@+id/chart_executing_status"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text=""
        android:textColor="#5F6368"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
