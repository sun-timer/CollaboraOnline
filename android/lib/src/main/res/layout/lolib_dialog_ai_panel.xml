<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/lolib_bg_ai_panel_root" android:layout_width="match_parent" android:layout_height="match_parent">
        <FrameLayout android:background="@drawable/lolib_bg_ai_panel_header" android:layout_width="match_parent" android:layout_height="@dimen/ai_sheet_header_height" android:paddingStart="@dimen/ai_panel_horizontal_margin" android:paddingEnd="@dimen/ai_panel_horizontal_margin">
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="match_parent">
                        <View android:layout_width="@dimen/ai_sheet_header_close_size" android:layout_height="@dimen/ai_sheet_header_close_size" android:importantForAccessibility="2"/>
                        <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                                <ImageView android:id="@+id/ai_header_logo" android:layout_width="@dimen/ai_sheet_header_icon_size" android:layout_height="@dimen/ai_sheet_header_icon_size" android:src="@drawable/lolib_ic_ai_assistant_logo" android:contentDescription="AI助手"/>
                                <TextView android:textSize="20sp" android:textColor="#101010" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI助手" android:layout_marginStart="@dimen/ai_sheet_header_title_gap"/>
                        </LinearLayout>
                        <ImageButton android:id="@+id/ai_close" android:background="?attr/selectableItemBackgroundBorderless" android:padding="8dp" android:layout_width="@dimen/ai_sheet_header_close_size" android:layout_height="@dimen/ai_sheet_header_close_size" android:src="@drawable/lolib_ic_dialog_close" android:scaleType="centerInside" android:contentDescription="关闭"/>
                </LinearLayout>
        </FrameLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/ai_tab_container" android:background="@drawable/lolib_bg_ai_tab_container" android:paddingTop="@dimen/ai_panel_tab_container_padding_v" android:paddingBottom="@dimen/ai_panel_tab_container_padding_v" android:layout_width="match_parent" android:layout_height="@dimen/ai_panel_tab_container_height" android:layout_marginTop="12dp" android:paddingStart="@dimen/ai_panel_tab_container_padding_h" android:paddingEnd="@dimen/ai_panel_tab_container_padding_h" android:layout_marginStart="@dimen/ai_panel_horizontal_margin" android:layout_marginEnd="@dimen/ai_panel_horizontal_margin">
                <FrameLayout android:layout_gravity="center_vertical" android:id="@+id/ai_tab_doc_qa_cell" android:background="@drawable/lolib_bg_ai_tab_cell_selected" android:layout_width="0dp" android:layout_height="@dimen/ai_panel_tab_selected_height" android:layout_weight="1">
                        <TextView android:textSize="16sp" android:textColor="#101010" android:gravity="center" android:id="@+id/ai_tab_doc_qa" android:background="@android:color/transparent" android:layout_width="match_parent" android:layout_height="match_parent" android:text="文档Q&amp;A"/>
                </FrameLayout>
                <FrameLayout android:layout_gravity="center_vertical" android:id="@+id/ai_tab_chat_cell" android:background="@android:color/transparent" android:layout_width="0dp" android:layout_height="@dimen/ai_panel_tab_selected_height" android:layout_weight="1" android:layout_marginStart="@dimen/ai_panel_tab_gap">
                        <TextView android:textSize="16sp" android:textColor="#6a6a6a" android:gravity="center" android:id="@+id/ai_tab_chat" android:background="@android:color/transparent" android:layout_width="match_parent" android:layout_height="match_parent" android:text="聊天"/>
                </FrameLayout>
        </LinearLayout>
        <ScrollView android:id="@+id/ai_messages_scroll" android:scrollbars="vertical" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:minHeight="120dp" android:fillViewport="true" android:layout_weight="1" android:overScrollMode="ifContentScrolls" android:layout_marginStart="@dimen/ai_panel_horizontal_margin" android:layout_marginEnd="@dimen/ai_panel_horizontal_margin">
                <LinearLayout android:orientation="vertical" android:id="@+id/ai_messages_container" android:paddingBottom="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </ScrollView>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/ai_progress_bar" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginStart="@dimen/ai_panel_horizontal_margin" android:layout_marginEnd="@dimen/ai_panel_horizontal_margin">
                <ProgressBar android:id="@+id/ai_progress_spinner" android:layout_width="20dp" android:layout_height="20dp" android:indeterminate="true" android:indeterminateTint="#1e88e5"/>
                <TextView android:textSize="13sp" android:textColor="#5f6368" android:id="@+id/ai_progress_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI 正在生成..." android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/ai_input_container" android:background="@drawable/lolib_bg_ai_panel_input" android:layout_width="match_parent" android:layout_height="@dimen/ai_panel_input_height" android:layout_marginTop="10dp" android:layout_marginBottom="12dp" android:paddingStart="16dp" android:paddingEnd="6dp" android:layout_marginStart="@dimen/ai_panel_horizontal_margin" android:layout_marginEnd="@dimen/ai_panel_horizontal_margin">
                <EditText android:textSize="16sp" android:textColor="#202124" android:textColorHint="#9aa0a6" android:gravity="center_vertical" android:id="@+id/ai_prompt" android:background="@android:color/transparent" android:layout_width="0dp" android:layout_height="match_parent" android:hint="发消息..." android:maxLines="3" android:layout_weight="1" android:inputType="textMultiLine" android:imeOptions="actionSend" android:textCursorDrawable="@drawable/lolib_ai_text_cursor" android:paddingEnd="8dp"/>
                <ImageButton android:id="@+id/ai_run" android:background="@drawable/lolib_bg_ai_send_button" android:padding="8dp" android:layout_width="@dimen/ai_panel_send_button_size" android:layout_height="@dimen/ai_panel_send_button_size" android:src="@drawable/lolib_ic_ai_send_plane" android:scaleType="centerInside" android:contentDescription="发送"/>
        </LinearLayout>
        <Button android:id="@+id/ai_cancel" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp"/>
        <Button android:id="@+id/ai_accept" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp"/>
        <TextView android:textSize="12sp" android:textColor="#5f6368" android:id="@+id/ai_status" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:layout_marginStart="@dimen/ai_panel_horizontal_margin" android:layout_marginEnd="@dimen/ai_panel_horizontal_margin"/>
        <TextView android:id="@+id/ai_output" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp"/>
</LinearLayout>
