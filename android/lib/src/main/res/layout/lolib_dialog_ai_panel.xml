<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lolib_bg_ai_panel_root"
    android:orientation="vertical">

    <!-- Figma 250:12839 标题栏：炫彩渐变，标题水平居中，关闭钮与下方内容右缘对齐 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ai_sheet_header_height"
        android:background="@drawable/lolib_bg_ai_panel_header"
        android:paddingStart="@dimen/ai_panel_horizontal_margin"
        android:paddingEnd="@dimen/ai_panel_horizontal_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/ai_sheet_header_close_size"
                android:layout_height="@dimen/ai_sheet_header_close_size"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ai_header_logo"
                    android:layout_width="@dimen/ai_sheet_header_icon_size"
                    android:layout_height="@dimen/ai_sheet_header_icon_size"
                    android:contentDescription="AI助手"
                    android:src="@drawable/lolib_ic_ai_assistant_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ai_sheet_header_title_gap"
                    android:text="AI助手"
                    android:textColor="#101010"
                    android:textSize="20sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/ai_close"
                android:layout_width="@dimen/ai_sheet_header_close_size"
                android:layout_height="@dimen/ai_sheet_header_close_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="关闭"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/lolib_ic_dialog_close" />
        </LinearLayout>
    </FrameLayout>

    <!-- Figma 250:12856 Tab 外框 76px→38dp，圆角 12px→6dp -->
    <LinearLayout
        android:id="@+id/ai_tab_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ai_panel_tab_container_height"
        android:layout_marginStart="@dimen/ai_panel_horizontal_margin"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/ai_panel_horizontal_margin"
        android:background="@drawable/lolib_bg_ai_tab_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ai_panel_tab_container_padding_h"
        android:paddingTop="@dimen/ai_panel_tab_container_padding_v"
        android:paddingEnd="@dimen/ai_panel_tab_container_padding_h"
        android:paddingBottom="@dimen/ai_panel_tab_container_padding_v">

        <FrameLayout
            android:id="@+id/ai_tab_doc_qa_cell"
            android:layout_width="0dp"
            android:layout_height="@dimen/ai_panel_tab_selected_height"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:background="@drawable/lolib_bg_ai_tab_cell_selected">

            <TextView
                android:id="@+id/ai_tab_doc_qa"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:text="文档Q&amp;A"
                android:textColor="#101010"
                android:textSize="16sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/ai_tab_chat_cell"
            android:layout_width="0dp"
            android:layout_height="@dimen/ai_panel_tab_selected_height"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/ai_panel_tab_gap"
            android:layout_weight="1"
            android:background="@android:color/transparent">

            <TextView
                android:id="@+id/ai_tab_chat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:text="聊天"
                android:textColor="#6A6A6A"
                android:textSize="16sp" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/ai_messages_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/ai_panel_horizontal_margin"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/ai_panel_horizontal_margin"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:minHeight="120dp"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/ai_messages_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="6dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/ai_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ai_panel_horizontal_margin"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/ai_panel_horizontal_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/ai_progress_spinner"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminate="true"
            android:indeterminateTint="#1E88E5" />

        <TextView
            android:id="@+id/ai_progress_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="AI 正在生成..."
            android:textColor="#5F6368"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ai_input_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ai_panel_input_height"
        android:layout_marginStart="@dimen/ai_panel_horizontal_margin"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="@dimen/ai_panel_horizontal_margin"
        android:layout_marginBottom="12dp"
        android:background="@drawable/lolib_bg_ai_panel_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="6dp">

        <EditText
            android:id="@+id/ai_prompt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:hint="发消息..."
            android:imeOptions="actionSend"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:paddingEnd="8dp"
            android:textColor="#202124"
            android:textColorHint="#9AA0A6"
            android:textCursorDrawable="@drawable/lolib_ai_text_cursor"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/ai_run"
            android:layout_width="@dimen/ai_panel_send_button_size"
            android:layout_height="@dimen/ai_panel_send_button_size"
            android:background="@drawable/lolib_bg_ai_send_button"
            android:contentDescription="发送"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/lolib_ic_ai_send_plane" />
    </LinearLayout>

    <Button
        android:id="@+id/ai_cancel"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/ai_accept"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ai_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ai_panel_horizontal_margin"
        android:layout_marginEnd="@dimen/ai_panel_horizontal_margin"
        android:layout_marginBottom="8dp"
        android:textColor="#5F6368"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ai_output"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

</LinearLayout>
