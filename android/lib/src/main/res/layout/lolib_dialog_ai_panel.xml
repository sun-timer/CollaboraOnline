<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- Header：淡紫→白渐变，标题居中，关闭按钮与下方内容右对齐 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/lolib_bg_ai_panel_header"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ai_header_logo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="AI助手"
                android:src="@drawable/lolib_ic_ai_assistant_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="AI助手"
                android:textColor="#101010"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/ai_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭"
            android:scaleType="centerInside"
            android:src="@drawable/lolib_ic_dialog_close" />
    </FrameLayout>

    <!-- Tab 区：灰底容器 76dp，选中 60dp / 未选中 76dp -->
    <LinearLayout
        android:id="@+id/ai_tab_container"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="#E2E3E5"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/ai_tab_doc_qa"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/lolib_bg_ai_tab_selected"
            android:gravity="center"
            android:text="文档Q&amp;A"
            android:textColor="#222222"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/ai_tab_chat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/lolib_bg_ai_tab_unselected"
            android:gravity="center"
            android:text="聊天"
            android:textColor="#80868B"
            android:textSize="16sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/ai_messages_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:minHeight="120dp"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/ai_messages_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="6dp" />
    </ScrollView>

    <!-- 底部输入框：圆角容器 + 56dp 发送按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/lolib_bg_ai_panel_input"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <EditText
            android:id="@+id/ai_prompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="发消息..."
            android:imeOptions="actionSend"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:minHeight="40dp"
            android:paddingEnd="8dp"
            android:textColor="#202124"
            android:textColorHint="#9AA0A6"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/ai_run"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/lolib_bg_ai_send_button"
            android:contentDescription="发送"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/lolib_ic_ai_send_plane" />
    </LinearLayout>

    <Button
        android:id="@+id/ai_cancel"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/ai_accept"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- AI Generating progress indicator (hidden by default) -->
    <LinearLayout
        android:id="@+id/ai_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/ai_progress_spinner"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminate="true"
            android:indeterminateTint="#1E88E5" />

        <TextView
            android:id="@+id/ai_progress_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="AI 正在生成..."
            android:textColor="#5F6368"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ai_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:textColor="#5F6368"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ai_output"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

</LinearLayout>
