<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/lolib_bg_dialog_outline" android:paddingTop="20dp" android:paddingBottom="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="24dp" android:paddingEnd="24dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="60dp">
                <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="#1f1f1f" android:gravity="center" android:layout_gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="生成大纲" android:paddingStart="56dp" android:paddingEnd="56dp"/>
                <ImageButton android:layout_gravity="top|end" android:id="@+id/outline_close_btn" android:background="?attr/selectableItemBackgroundBorderless" android:padding="8dp" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginTop="10dp" android:src="@drawable/lolib_ic_dialog_close" android:scaleType="centerInside" android:contentDescription="关闭" android:layout_marginEnd="16dp"/>
        </FrameLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/outline_type_card" android:background="@drawable/lolib_bg_outline_edit" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="51dp" android:layout_marginTop="12dp" android:paddingStart="16dp" android:paddingEnd="12dp">
                <TextView android:textSize="16sp" android:textColor="#333333" android:id="@+id/outline_type_label" android:layout_width="0dp" android:layout_height="wrap_content" android:text="通用文档" android:layout_weight="1"/>
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/lolib_ic_arrow_down" android:contentDescription="选择类型"/>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:id="@+id/outline_desc_card" android:background="@drawable/lolib_bg_outline_edit" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="160dp" android:paddingStart="16dp" android:paddingEnd="16dp">
                <EditText android:textSize="16sp" android:textColor="#101010" android:textColorHint="#999999" android:gravity="top|start" android:id="@+id/outline_desc_edit" android:background="@null" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="128dp" android:hint="请输入补充说明，例如：围绕数字化转型展开，面向中层管理者..." android:inputType="0x00024001"/>
        </LinearLayout>
        <FrameLayout android:id="@+id/outline_result_card" android:background="@drawable/lolib_bg_outline_edit" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="200dp">
                <androidx.core.widget.NestedScrollView android:scrollbarSize="4dp" android:scrollbarThumbVertical="@drawable/lolib_scrollbar_thumb" android:scrollbarStyle="0x00000000" android:id="@+id/outline_result_scroll" android:paddingTop="12dp" android:paddingBottom="48dp" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true" android:fadeScrollbars="false" android:paddingStart="16dp" android:paddingEnd="6dp">
                        <TextView android:textSize="16sp" android:textColor="#101010" android:id="@+id/outline_result_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="正在生成大纲..." android:lineSpacingExtra="4dp"/>
                </androidx.core.widget.NestedScrollView>
                <LinearLayout android:gravity="center_vertical" android:layout_gravity="bottom|end" android:orientation="horizontal" android:id="@+id/outline_copy_row" android:background="?attr/selectableItemBackground" android:focusable="true" android:clickable="true" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginBottom="4dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginStart="12dp" android:layout_marginEnd="8dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/lolib_ic_copy" android:contentDescription="复制"/>
                        <TextView android:textSize="14sp" android:textColor="#6a6a6a" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="复制" android:layout_marginStart="4dp"/>
                </LinearLayout>
        </FrameLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/outline_generate_btn" android:background="@drawable/lolib_bg_gradient_button_outline" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginTop="12dp" android:paddingStart="20dp" android:paddingEnd="20dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/lolib_ic_btn_generate" android:contentDescription="生成"/>
                <TextView android:textSize="16sp" android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开始生成" android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:id="@+id/outline_done_row" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/outline_regenerate_btn" android:background="@drawable/lolib_bg_outline_secondary_button" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:layout_marginEnd="8dp">
                        <TextView android:textSize="16sp" android:textColor="#e5000000" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="重新生成"/>
                </LinearLayout>
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/outline_apply_btn" android:background="@drawable/lolib_bg_gradient_button_outline" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:layout_marginStart="8dp">
                        <TextView android:textSize="16sp" android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="插入文档"/>
                </LinearLayout>
        </LinearLayout>
</LinearLayout>
