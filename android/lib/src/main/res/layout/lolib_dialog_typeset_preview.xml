<?xml version="1.0" encoding="utf-8"?>
<!-- AI排版结果预览弹窗 overlay，挂在 doc_main_content。
     设计参考 SVG: 670×1320, 白底 24dp 圆角。
     尺寸由 LOActivity.positionTypesetPreviewOverlay() 运行时覆写。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/typeset_preview_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <!-- 白色卡片 -->
    <LinearLayout
        android:id="@+id/typeset_preview_card"
        android:layout_width="328dp"
        android:layout_height="660dp"
        android:layout_gravity="center"
        android:background="@drawable/lolib_bg_dialog_outline"
        android:elevation="40dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- ===== 标题栏 ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/typeset_preview_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="AI排版结果预览"
                android:textColor="#15171A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/typeset_preview_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="关闭"
                android:focusable="true"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </FrameLayout>

        <!-- ===== 预览区（WebView） ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:background="@drawable/lolib_bg_typeset_preview_border">

            <WebView
                android:id="@+id/typeset_preview_webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:background="#FFFFFF" />
        </FrameLayout>

        <!-- ===== 底部按钮 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- 重新生成 -->
            <TextView
                android:id="@+id/typeset_preview_regenerate"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/lolib_bg_outline_secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="重新生成"
                android:textColor="#1F1F1F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 插入文档 -->
            <TextView
                android:id="@+id/typeset_preview_insert"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/lolib_bg_gradient_button_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="插入文档"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
