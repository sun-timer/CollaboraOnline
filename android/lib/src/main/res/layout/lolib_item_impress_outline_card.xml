<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/impress_outline_card_page_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#DD00CE"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/impress_outline_card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/lolib_bg_outline_edit"
        android:hint="页面标题"
        android:padding="8dp"
        android:textColor="#1A1A1A"
        android:textSize="15sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/impress_outline_card_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/lolib_bg_outline_edit"
        android:gravity="start|top"
        android:hint="页面内容"
        android:inputType="textMultiLine"
        android:minHeight="60dp"
        android:padding="8dp"
        android:textColor="#333333"
        android:textSize="13sp" />
</LinearLayout>
