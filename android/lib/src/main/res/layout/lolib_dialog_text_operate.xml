<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/lolib_bg_dialog_outline" android:paddingTop="20dp" android:paddingBottom="24dp" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="24dp" android:paddingEnd="24dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="60dp">
                <TextView android:textSize="20sp" android:textStyle="0x00000001" android:textColor="#1f1f1f" android:gravity="center" android:layout_gravity="center" android:id="@+id/text_op_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="文案扩写" android:paddingStart="56dp" android:paddingEnd="56dp"/>
                <ImageButton android:layout_gravity="top|end" android:id="@+id/text_op_close_btn" android:background="?attr/selectableItemBackgroundBorderless" android:padding="8dp" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginTop="10dp" android:src="@drawable/lolib_ic_dialog_close" android:scaleType="centerinside" android:contentDescription="关闭" android:layout_marginEnd="16dp"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/text_op_input_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1"/>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/text_op_generate_btn" android:background="@drawable/lolib_bg_gradient_button_outline" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="35dp" android:layout_marginTop="12dp" android:paddingStart="20dp" android:paddingEnd="20dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/lolib_ic_btn_generate" android:contentDescription="开始生成"/>
                <TextView android:textSize="16sp" android:textColor="#ffffff" android:id="@+id/text_op_generate_btn_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开始生成" android:layout_marginStart="4dp"/>
        </LinearLayout>
        <androidx.core.widget.NestedScrollView android:scrollbarSize="4dp" android:scrollbarThumbVertical="@drawable/lolib_scrollbar_thumb" android:scrollbarStyle="0x00000000" android:id="@+id/text_op_result_card" android:background="@drawable/lolib_bg_outline_edit" android:paddingTop="12dp" android:paddingBottom="48dp" android:visibility="gone" android:scrollbars="0x00000200" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:fillViewport="true" android:layout_weight="1" android:fadeScrollbars="false" android:paddingStart="16dp" android:paddingEnd="6dp">
                <TextView android:textSize="16sp" android:textColor="#101010" android:id="@+id/text_op_result_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="正在生成..." android:lineSpacingExtra="4dp"/>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout android:gravity="center_vertical" android:layout_gravity="end" android:orientation="horizontal" android:id="@+id/text_op_copy_row" android:background="?attr/selectableItemBackground" android:focusable="true" android:visibility="gone" android:clickable="true" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="8dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginEnd="8dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/lolib_ic_copy" android:contentDescription="复制"/>
                <TextView android:textSize="14sp" android:textColor="#6a6a6a" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="复制" android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:id="@+id/text_op_done_row" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/text_op_regenerate_btn" android:background="@drawable/lolib_bg_outline_secondary_button" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:layout_marginEnd="8dp">
                        <TextView android:textSize="16sp" android:textColor="#e5000000" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="重新生成"/>
                </LinearLayout>
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/text_op_apply_btn" android:background="@drawable/lolib_bg_gradient_button_outline" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:layout_marginStart="8dp">
                        <TextView android:textSize="16sp" android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="插入文档"/>
                </LinearLayout>
        </LinearLayout>
</LinearLayout>
