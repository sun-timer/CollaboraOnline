<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:paddingBottom="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp">
        <LinearLayout android:layout_gravity="center_horizontal" android:orientation="vertical" android:background="@drawable/lolib_bg_dialog_outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxWidth="@dimen/ai_typeset_dialog_width">
                <FrameLayout android:layout_width="match_parent" android:layout_height="@dimen/ai_typeset_title_height" android:paddingStart="@dimen/ai_typeset_header_padding_h" android:paddingEnd="@dimen/ai_typeset_header_padding_h">
                        <View android:layout_gravity="center" android:layout_width="@dimen/ai_sheet_header_close_size" android:layout_height="@dimen/ai_sheet_header_close_size" android:importantForAccessibility="2"/>
                        <TextView android:textSize="20sp" android:textColor="#1f1f1f" android:gravity="center" android:layout_gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AI 排版" android:fontFamily="sans-serif-medium"/>
                        <FrameLayout android:layout_gravity="center" android:id="@+id/typeset_select_close" android:background="@drawable/lolib_bg_typeset_close_circle" android:focusable="true" android:clickable="true" android:layout_width="@dimen/ai_sheet_header_close_size" android:layout_height="@dimen/ai_sheet_header_close_size" android:contentDescription="关闭">
                                <ImageView android:layout_gravity="center" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/lolib_ic_dialog_close" android:scaleType="centerinside" android:importantForAccessibility="2"/>
                        </FrameLayout>
                </FrameLayout>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" android:paddingStart="@dimen/ai_typeset_content_padding" android:paddingEnd="@dimen/ai_typeset_content_padding">
                        <LinearLayout android:orientation="vertical" android:id="@+id/typeset_type_paper" android:background="@drawable/lolib_bg_typeset_card_paper_selected" android:padding="@dimen/ai_typeset_card_padding" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="@dimen/ai_typeset_card_min_height" android:layout_weight="1" android:layout_marginEnd="8dp">
                                <FrameLayout android:background="@drawable/lolib_bg_typeset_preview_thumb" android:padding="8dp" android:layout_width="match_parent" android:layout_height="@dimen/ai_typeset_card_preview_height">
                                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/lolib_preview_paper" android:scaleType="fitcenter" android:contentDescription="论文预览"/>
                                </FrameLayout>
                                <TextView android:textSize="14sp" android:textColor="#101010" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ai_typeset_card_label_margin_top" android:text="论文"/>
                        </LinearLayout>
                        <LinearLayout android:orientation="vertical" android:id="@+id/typeset_type_gov" android:background="@drawable/lolib_bg_typeset_card_gov" android:padding="@dimen/ai_typeset_card_padding" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="@dimen/ai_typeset_card_min_height" android:layout_weight="1" android:layout_marginStart="8dp">
                                <FrameLayout android:background="@drawable/lolib_bg_typeset_preview_thumb" android:padding="8dp" android:layout_width="match_parent" android:layout_height="@dimen/ai_typeset_card_preview_height">
                                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/lolib_preview_gov" android:scaleType="fitcenter" android:contentDescription="党政公文预览"/>
                                </FrameLayout>
                                <TextView android:textSize="14sp" android:textColor="#101010" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ai_typeset_card_label_margin_top" android:text="党政公文"/>
                        </LinearLayout>
                </LinearLayout>
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ai_typeset_card_gap" android:baselineAligned="false" android:paddingStart="@dimen/ai_typeset_content_padding" android:paddingEnd="@dimen/ai_typeset_content_padding">
                        <LinearLayout android:orientation="vertical" android:id="@+id/typeset_type_contract" android:background="@drawable/lolib_bg_typeset_card_contract" android:padding="@dimen/ai_typeset_card_padding" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="@dimen/ai_typeset_card_min_height" android:layout_weight="1" android:layout_marginEnd="8dp">
                                <FrameLayout android:background="@drawable/lolib_bg_typeset_preview_thumb" android:padding="8dp" android:layout_width="match_parent" android:layout_height="@dimen/ai_typeset_card_preview_height">
                                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/lolib_preview_contract" android:scaleType="fitcenter" android:contentDescription="合同预览"/>
                                </FrameLayout>
                                <TextView android:textSize="14sp" android:textColor="#101010" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ai_typeset_card_label_margin_top" android:text="合同协议"/>
                        </LinearLayout>
                        <LinearLayout android:orientation="vertical" android:id="@+id/typeset_type_general" android:background="@drawable/lolib_bg_typeset_card_general" android:padding="@dimen/ai_typeset_card_padding" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="@dimen/ai_typeset_card_min_height" android:layout_weight="1" android:layout_marginStart="8dp">
                                <FrameLayout android:background="@drawable/lolib_bg_typeset_preview_thumb" android:padding="8dp" android:layout_width="match_parent" android:layout_height="@dimen/ai_typeset_card_preview_height">
                                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/lolib_preview_general" android:scaleType="fitcenter" android:contentDescription="通用文档预览"/>
                                </FrameLayout>
                                <TextView android:textSize="14sp" android:textColor="#101010" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ai_typeset_card_label_margin_top" android:text="通用文档"/>
                        </LinearLayout>
                </LinearLayout>
                <FrameLayout android:paddingTop="@dimen/ai_typeset_button_padding_v" android:paddingBottom="@dimen/ai_typeset_button_padding_v" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/ai_typeset_button_padding_h" android:paddingEnd="@dimen/ai_typeset_button_padding_h">
                        <TextView android:textSize="16sp" android:textColor="#ffffff" android:gravity="center" android:id="@+id/typeset_select_start" android:background="@drawable/lolib_bg_gradient_button_outline" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="@dimen/ai_typeset_button_height" android:text="开始排版"/>
                </FrameLayout>
        </LinearLayout>
</FrameLayout>
