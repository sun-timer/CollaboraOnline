<?xml version="1.0" encoding="utf-8"?>
<!-- 生成PPT弹窗：宽≈min(670dp,屏宽-48dp)，输入态高度随内容(Hug) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lolib_bg_dialog_outline"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="50dp"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp">

        <ImageButton
            android:id="@+id/impress_outline_back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|start"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/lolib_ic_top_back"
            android:visibility="gone" />

        <TextView
            android:id="@+id/impress_outline_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/impress_ppt_dialog_title"
            android:textColor="#101010"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/impress_outline_close_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/lolib_ic_dialog_close" />
    </FrameLayout>

    <!-- ============ 状态 0: 输入态 ============ -->
    <LinearLayout
        android:id="@+id/impress_outline_input_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/impress_outline_mode_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/lolib_bg_outline_edit"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/impress_outline_mode_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/impress_ppt_mode_quick"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="选择方式"
                android:src="@drawable/lolib_ic_arrow_down" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/impress_outline_input_card"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/lolib_bg_outline_edit"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <EditText
                android:id="@+id/impress_outline_quick_input"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="start|top"
                android:hint="@string/impress_ppt_input_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:textColor="#101010"
                android:textColorHint="#999999"
                android:textSize="16sp"
                android:visibility="visible" />

            <FrameLayout
                android:id="@+id/impress_outline_doc_group"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/impress_outline_doc_upload_zone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/lolib_bg_impress_doc_upload_zone"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="20dp">

                    <LinearLayout
                        android:id="@+id/impress_outline_doc_empty_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@string/impress_ppt_select_file"
                            android:src="@drawable/lolib_ic_impress_doc_upload" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/impress_ppt_doc_upload_title"
                            android:textColor="#333333"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/impress_ppt_doc_upload_hint"
                            android:textColor="#999999"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/impress_outline_doc_selected_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="@string/impress_ppt_select_file"
                            android:src="@drawable/lolib_ic_top_open_docs" />

                        <TextView
                            android:id="@+id/impress_outline_doc_file_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:ellipsize="middle"
                            android:gravity="center"
                            android:maxLines="2"
                            android:textColor="#333333"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/impress_outline_doc_reselect_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/impress_ppt_doc_reselect"
                            android:textColor="#EC5D1F"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <EditText
                android:id="@+id/impress_outline_paste_input"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="start|top"
                android:hint="@string/impress_ppt_paste_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:textColor="#101010"
                android:textColorHint="#999999"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    android:id="@+id/impress_outline_page_pill"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/lolib_bg_impress_ppt_pill"
                    android:drawableEnd="@drawable/lolib_ic_chevron_down"
                    android:drawablePadding="2dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp"
                    android:text="11-20页"
                    android:textColor="#333333"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/impress_outline_audience_pill"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/lolib_bg_impress_ppt_pill"
                    android:drawableEnd="@drawable/lolib_ic_chevron_down"
                    android:drawablePadding="2dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp"
                    android:text="大众"
                    android:textColor="#333333"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/impress_outline_style_pill"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/lolib_bg_impress_ppt_pill"
                    android:drawableEnd="@drawable/lolib_ic_chevron_down"
                    android:drawablePadding="2dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp"
                    android:text="学术报告"
                    android:textColor="#333333"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/impress_outline_generate_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/lolib_bg_gradient_button_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="生成"
                android:src="@drawable/lolib_ic_btn_generate" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/impress_ppt_start_generate"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ 状态 1: 生成大纲中（对齐 Calc AI 弹窗停止态） ============ -->
    <LinearLayout
        android:id="@+id/impress_outline_generating_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="43dp"
            android:background="@drawable/lolib_bg_calc_formula_input">

            <TextView
                android:id="@+id/impress_outline_generating_query"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center_vertical|end"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#999999"
                android:textSize="16sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="start"
            android:orientation="vertical">

            <TextView
                android:id="@+id/impress_outline_generating_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/impress_ppt_generating_outline_status"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/impress_outline_generating_spinner"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:indeterminateTint="#333333" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/impress_outline_stop_group"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/lolib_bg_calc_formula_stop_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/lolib_bg_calc_formula_stop_icon">

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/impress_ppt_stop_generate"
                    android:src="@drawable/lolib_ic_continue_stop" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/impress_ppt_stop_generate"
                android:textColor="#FE3A3A"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ 状态 2: 完成态（大纲列表） ============ -->
    <LinearLayout
        android:id="@+id/impress_outline_completed_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/impress_outline_completed_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:fadeScrollbars="false"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/lolib_bg_outline_edit"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/impress_outline_card_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/impress_outline_copy_row"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="复制"
                        android:src="@drawable/lolib_ic_copy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/impress_ppt_copy"
                        android:textColor="#666666"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/impress_outline_regenerate_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/lolib_bg_impress_outline_secondary_button"
                android:gravity="center"
                android:text="@string/impress_ppt_regenerate"
                android:textColor="#333333"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/impress_outline_template_btn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/lolib_bg_gradient_button_outline"
                android:gravity="center"
                android:text="@string/impress_ppt_select_template"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ 状态 5: 模板选择 ============ -->
    <LinearLayout
        android:id="@+id/impress_outline_template_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/impress_template_recommended_label"
                android:textColor="#101010"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/impress_template_style_filter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/lolib_bg_outline_edit"
                android:drawableEnd="@drawable/lolib_ic_chevron_down"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:minWidth="88dp"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:text="@string/impress_template_filter_all"
                android:textColor="#333333"
                android:textSize="14sp" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/impress_outline_template_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/template_grid_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/impress_outline_template_generate_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:alpha="0.45"
            android:background="@drawable/lolib_bg_gradient_button_outline"
            android:clickable="true"
            android:enabled="false"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="生成"
                android:src="@drawable/lolib_ic_btn_generate" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/impress_ppt_generate_action"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ 状态 3: 错误态 ============ -->
    <LinearLayout
        android:id="@+id/impress_outline_error_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/impress_outline_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FF4444"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/impress_outline_error_retry_btn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/lolib_bg_gradient_button_outline"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/impress_ppt_regenerate"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- ============ 状态 4: 生成 PPT 中 ============ -->
    <LinearLayout
        android:id="@+id/impress_outline_generating_ppt_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/impress_outline_generating_ppt_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/impress_outline_generating_ppt_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/impress_generating_ppt"
            android:textColor="#101010"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/impress_outline_generating_ppt_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/impress_generating_ppt_detail"
            android:textColor="#5F6368"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
