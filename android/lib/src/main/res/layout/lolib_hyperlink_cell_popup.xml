<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hyperlink_cell_popup_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/lolib_bg_function_card_figma"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:maxWidth="320dp"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/hyperlink_cell_popup_link"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#1278D9"
        android:textSize="15sp" />

    <ImageButton
        android:id="@+id/hyperlink_cell_popup_copy"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="复制链接"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/lolib_ic_selection_copy" />

    <ImageButton
        android:id="@+id/hyperlink_cell_popup_remove"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="移除链接"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/lolib_ic_selection_delete" />

</LinearLayout>
