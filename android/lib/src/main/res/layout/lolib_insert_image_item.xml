<?xml version="1.0" encoding="utf-8"?>
<!-- 插入图片网格 item(Figma 220x220px 格):图 + 右上多选框角标 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/insertImageItemImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_insert_image_grid_item"
        android:contentDescription="@string/insert_image_select"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/insertImageItemCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="@string/insert_image_select"
        android:src="@drawable/lolib_ic_checkbox_circle_unchecked" />
</FrameLayout>