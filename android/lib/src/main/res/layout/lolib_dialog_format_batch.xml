<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/lolib_bg_dialog_outline" android:paddingTop="20dp" android:paddingBottom="24dp" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="24dp" android:paddingEnd="24dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="#1f1f1f" android:gravity="center" android:id="@+id/format_batch_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="格式批量处理"/>
                <ImageButton android:layout_gravity="end|top" android:id="@+id/format_batch_close_btn" android:background="?attr/selectableItemBackgroundBorderless" android:padding="8dp" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginTop="10dp" android:src="@drawable/lolib_ic_dialog_close" android:scaleType="centerInside" android:contentDescription="关闭" android:layout_marginEnd="16dp"/>
        </FrameLayout>
        <ScrollView android:id="@+id/format_batch_options_container" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="16dp" android:layout_weight="1" android:fadeScrollbars="false">
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <CheckBox android:textSize="16sp" android:textColor="#333333" android:id="@+id/fb_option_en_to_zh" android:layout_width="match_parent" android:layout_height="48dp" android:button="@drawable/lolib_checkbox_format_batch" android:text="英文标点转中文" android:paddingStart="8dp"/>
                        <CheckBox android:textSize="16sp" android:textColor="#333333" android:id="@+id/fb_option_zh_to_en" android:layout_width="match_parent" android:layout_height="48dp" android:button="@drawable/lolib_checkbox_format_batch" android:text="中文标点转英文" android:paddingStart="8dp"/>
                        <CheckBox android:textSize="16sp" android:textColor="#333333" android:id="@+id/fb_option_ghost" android:layout_width="match_parent" android:layout_height="48dp" android:button="@drawable/lolib_checkbox_format_batch" android:text="幽灵字符转空格" android:paddingStart="8dp"/>
                        <CheckBox android:textSize="16sp" android:textColor="#333333" android:id="@+id/fb_option_blank_lines" android:layout_width="match_parent" android:layout_height="48dp" android:button="@drawable/lolib_checkbox_format_batch" android:text="删除多余空行" android:paddingStart="8dp"/>
                        <CheckBox android:textSize="16sp" android:textColor="#333333" android:id="@+id/fb_option_wavy" android:layout_width="match_parent" android:layout_height="48dp" android:button="@drawable/lolib_checkbox_format_batch" android:text="消除下滑波浪线" android:paddingStart="8dp"/>
                        <CheckBox android:textSize="16sp" android:textColor="#333333" android:id="@+id/fb_option_hyperlink" android:layout_width="match_parent" android:layout_height="48dp" android:button="@drawable/lolib_checkbox_format_batch" android:text="消除超链接识别" android:paddingStart="8dp"/>
                </LinearLayout>
        </ScrollView>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/format_batch_execute_btn" android:background="@drawable/lolib_bg_gradient_button_outline" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/lolib_ic_btn_generate" android:contentDescription="开始执行"/>
                <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开始执行" android:layout_marginStart="8dp"/>
        </LinearLayout>
        <androidx.core.widget.NestedScrollView android:scrollbarStyle="insideOverlay" android:id="@+id/format_batch_result_card" android:background="@drawable/lolib_bg_outline_edit" android:visibility="gone" android:scrollbars="vertical" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="16dp" android:fillViewport="true" android:layout_weight="1" android:fadeScrollbars="false">
                <TextView android:textSize="16sp" android:textColor="#333333" android:id="@+id/format_batch_result_text" android:paddingTop="16dp" android:paddingBottom="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingExtra="4dp" android:paddingStart="20dp" android:paddingEnd="20dp"/>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/format_batch_copy_row" android:background="?attr/selectableItemBackground" android:focusable="true" android:visibility="gone" android:clickable="true" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="12dp">
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/lolib_ic_copy" android:contentDescription="复制"/>
                <TextView android:textSize="16sp" android:textColor="#6a6a6a" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="复制" android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:id="@+id/format_batch_done_row" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/format_batch_regenerate_btn" android:background="@drawable/lolib_bg_outline_secondary_button" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginEnd="12dp">
                        <TextView android:textSize="18sp" android:textColor="#333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="重新生成"/>
                </LinearLayout>
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/format_batch_apply_btn" android:background="@drawable/lolib_bg_gradient_button_outline" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginStart="12dp">
                        <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="插入文档"/>
                </LinearLayout>
        </LinearLayout>
</LinearLayout>
