<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mobile_phone_preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <View
        android:id="@+id/mobile_phone_preview_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:text="手机预览"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/mobile_phone_preview_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="关闭"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/lolib_ic_dialog_close"
        android:tint="#FFFFFF" />

    <FrameLayout
        android:id="@+id/mobile_phone_preview_frame"
        android:layout_width="200dp"
        android:layout_height="400dp"
        android:layout_gravity="center"
        android:background="@drawable/lolib_bg_mobile_phone_preview_frame"
        android:clickable="false"
        android:clipToOutline="true"
        android:elevation="8dp"
        android:focusable="false" />
</FrameLayout>
