<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="335dp"
    android:layout_height="wrap_content"
    android:background="@drawable/lolib_wai_bg_dialog"
    android:paddingBottom="12dp">

    <include layout="@layout/lolib_wai_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/wai_translate_source_card"
                android:layout_width="120dp"
                android:layout_height="32dp"
                android:background="@drawable/lolib_wai_bg_chip"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/wai_translate_source_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    android:textColor="#101010"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="自动识别" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/lolib_wai_ic_chevron_down"
                    android:contentDescription="选择语言" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/wai_translate_swap_btn"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/lolib_wai_ic_swap"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="交换语言" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/wai_translate_target_card"
                android:layout_width="120dp"
                android:layout_height="32dp"
                android:background="@drawable/lolib_wai_bg_chip"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/wai_translate_target_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    android:textColor="#1278D9"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="中文" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/lolib_wai_ic_chevron_down"
                    android:contentDescription="选择语言" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:background="@drawable/lolib_wai_bg_box"
            android:padding="10dp">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/wai_translate_source_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="vertical"
                android:scrollbarSize="4dp"
                android:scrollbarThumbVertical="@drawable/lolib_wai_scrollbar"
                android:scrollbarStyle="insideOverlay">

                <EditText
                    android:id="@+id/wai_translate_source_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@null"
                    android:gravity="bottom"
                    android:textSize="16sp"
                    android:textColor="#101010"
                    android:lineSpacingExtra="8dp"
                    android:inputType="textMultiLine"
                    android:hint="" />
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:background="@drawable/lolib_wai_bg_box"
            android:padding="10dp">

            <TextView
                android:id="@+id/wai_translate_hint_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#999999"
                android:lineSpacingExtra="8dp"
                android:text="翻译结果" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/wai_translate_result_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:scrollbars="vertical"
                    android:scrollbarSize="4dp"
                    android:scrollbarThumbVertical="@drawable/lolib_wai_scrollbar"
                    android:scrollbarStyle="insideOverlay"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/wai_translate_result_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#101010"
                        android:lineSpacingExtra="8dp"
                        android:text="" />
                </androidx.core.widget.NestedScrollView>

                <LinearLayout
                    android:id="@+id/wai_translate_copy_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/lolib_wai_ic_copy"
                        android:contentDescription="复制" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textSize="14sp"
                        android:textColor="#6A6A6A"
                        android:text="复制" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wai_translate_cta_bar"
        android:layout_width="match_parent"
        android:layout_height="59dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:id="@+id/wai_translate_generate_btn"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="1"
            android:background="@drawable/lolib_bg_continue_pill_primary_35"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/lolib_wai_ic_sparkle"
                android:contentDescription="翻译" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:text="开始翻译" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wai_translate_result_bar"
        android:layout_width="match_parent"
        android:layout_height="59dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/wai_translate_regenerate_btn"
            android:layout_width="120dp"
            android:layout_height="35dp"
            android:background="@drawable/lolib_bg_continue_pill_secondary_35"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="#E5000000"
            android:clickable="true"
            android:focusable="true"
            android:text="重新生成" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/wai_translate_insert_btn"
            android:layout_width="120dp"
            android:layout_height="35dp"
            android:background="@drawable/lolib_bg_continue_pill_primary_35"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:text="插入文档" />
    </LinearLayout>
</LinearLayout>
