<?xml version="1.0" encoding="utf-8"?>
<!-- Calc AI数据处理弹窗 panel：四态（输入态/生成中态/完成态/执行中态）。
     尺寸由 LOActivity.positionDataProcessDialogCenter() 运行时覆写。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dp_dialog_root"
    android:layout_width="328dp"
    android:layout_height="560dp"
    android:background="@drawable/lolib_bg_continue_dialog"
    android:elevation="50dp"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- ========== 标题栏 ========== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/dp_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="AI数据处理"
            android:textColor="#15171A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/dp_close_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="关闭"
            android:focusable="true"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </FrameLayout>

    <!-- ========== 选中区域提示 ========== -->
    <TextView
        android:id="@+id/dp_range_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#5F6368"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- ========== 输入区（输入态可见） ========== -->
    <LinearLayout
        android:id="@+id/dp_input_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="visible">

        <EditText
            android:id="@+id/dp_input"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/lolib_bg_continue_dialog"
            android:gravity="top|start"
            android:hint="重复数据全部清除"
            android:inputType="textMultiLine"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:textColor="#15171A"
            android:textColorHint="#9AA0A6"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/dp_generate_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/lolib_bg_continue_pill_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✨ 开始生成"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- ========== 内容区（生成中态/完成态可见） ========== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/dp_content_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dp_user_input_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F0F2F5"
                android:padding="10dp"
                android:text=""
                android:textColor="#5F6368"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dp_content_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="top"
                android:lineSpacingExtra="4dp"
                android:text=""
                android:textColor="#15171A"
                android:textSize="15sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ========== 生成中态：状态文字 ========== -->
    <TextView
        android:id="@+id/dp_generating_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="正在生成数据处理方案..."
        android:textColor="#8A5CFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- ========== 生成中态：停止按钮 ========== -->
    <FrameLayout
        android:id="@+id/dp_stop_button"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/lolib_bg_continue_stop_button"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="停止生成"
            android:src="@drawable/lolib_ic_continue_stop" />
    </FrameLayout>

    <!-- ========== 完成态：重新生成 + 执行操作 ========== -->
    <LinearLayout
        android:id="@+id/dp_completed_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/dp_regenerate_button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:background="@drawable/lolib_bg_continue_pill_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="重新生成"
            android:textColor="#15171A"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/dp_execute_button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@drawable/lolib_bg_continue_pill_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="执行操作"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- ========== 执行中态：进度文字 ========== -->
    <TextView
        android:id="@+id/dp_executing_status"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text=""
        android:textColor="#5F6368"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
