<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/doc_top_toolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/lolib_chrome_status_plate"
    android:elevation="8dp"
    android:orientation="vertical">

    <!-- Figma 556:21271：状态栏区域与顶栏共用 #F2F2F2 底板，高度由 SystemUiHelper 注入 -->
    <View
        android:id="@+id/doc_top_status_plate"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:minHeight="@dimen/lolib_status_plate_min_height"
        android:background="@color/lolib_chrome_status_plate"
        android:importantForAccessibility="no" />

    <!-- Preview / Viewing mode — Figma 标题栏2 内容区 56dp（在 status plate 下方，不在状态栏内） -->
    <LinearLayout
        android:id="@+id/top_toolbar_preview"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lolib_top_toolbar_content_height"
        android:background="@color/lolib_chrome_status_plate"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/doc_top_toolbar_content_padding_h"
        android:paddingEnd="@dimen/doc_top_toolbar_content_padding_h">

        <ImageButton
            android:id="@+id/top_btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/lolib_ic_top_back" />

        <TextView
            android:id="@+id/top_title_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="0dp"
            android:paddingEnd="8dp"
            android:textColor="#101010"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/top_btn_search_preview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="查找替换"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/lolib_ic_top_search" />

        <ImageButton
            android:id="@+id/top_btn_share_preview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="分享"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/lolib_ic_top_share" />

        <FrameLayout
            android:id="@+id/top_btn_open_docs_preview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="已打开文档"
            android:focusable="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/lolib_ic_top_open_docs" />

            <TextView
                android:id="@+id/top_open_docs_count_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:importantForAccessibility="no"
                android:textColor="#000000"
                android:textSize="10sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Edit mode — 56dp 内容区 -->
    <FrameLayout
        android:id="@+id/top_toolbar_edit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/lolib_top_toolbar_content_height"
        android:background="@color/lolib_chrome_status_plate"
        android:paddingStart="@dimen/top_toolbar_edit_padding_start"
        android:paddingEnd="@dimen/top_toolbar_edit_padding_end"
        android:visibility="gone">

        <TextView
            android:id="@+id/top_btn_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/lolib_bg_top_done_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="20dp"
            android:paddingBottom="6dp"
            android:text="完成"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/top_btn_undo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="撤销"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/lolib_ic_top_undo" />

            <ImageButton
                android:id="@+id/top_btn_redo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="恢复"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/lolib_ic_top_redo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/top_btn_open_docs_edit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="已打开文档"
                android:focusable="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/lolib_ic_top_open_docs" />

                <TextView
                    android:id="@+id/top_open_docs_count_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:importantForAccessibility="no"
                    android:textColor="#000000"
                    android:textSize="10sp" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/top_btn_close_edit"
                android:layout_width="@dimen/doc_top_toolbar_close_size"
                android:layout_height="@dimen/doc_top_toolbar_close_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="关闭编辑"
                android:padding="@dimen/doc_top_toolbar_close_icon_padding"
                android:scaleType="centerInside"
                android:src="@drawable/lolib_ic_top_close_edit" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
