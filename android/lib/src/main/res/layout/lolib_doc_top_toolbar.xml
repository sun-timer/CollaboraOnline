<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/doc_top_toolbar" android:background="@color/lolib_chrome_status_plate" android:layout_width="match_parent" android:layout_height="wrap_content" android:elevation="8dp">
        <View android:id="@+id/doc_top_status_plate" android:background="@color/lolib_chrome_status_plate" android:layout_width="match_parent" android:layout_height="0dp" android:minHeight="@dimen/lolib_status_plate_min_height" android:importantForAccessibility="2"/>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/top_toolbar_preview" android:background="@color/lolib_chrome_status_plate" android:layout_width="match_parent" android:layout_height="@dimen/lolib_top_toolbar_content_height" android:paddingStart="@dimen/doc_top_toolbar_content_padding_h" android:paddingEnd="@dimen/doc_top_toolbar_content_padding_h">
                <ImageButton android:id="@+id/top_btn_back" android:background="?attr/selectableItemBackgroundBorderless" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/lolib_ic_top_back" android:scaleType="fitcenter" android:contentDescription="返回" android:paddingStart="16dp" android:paddingEnd="8dp"/>
                <TextView android:textSize="18sp" android:textColor="#101010" android:ellipsize="3" android:id="@+id/top_title_preview" android:layout_width="0dp" android:layout_height="wrap_content" android:maxLines="1" android:layout_weight="1" android:paddingStart="0dp" android:paddingEnd="8dp"/>
                <ImageButton android:id="@+id/top_btn_search_preview" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/lolib_ic_top_search" android:scaleType="fitcenter" android:contentDescription="查找替换"/>
                <ImageButton android:id="@+id/top_btn_share_preview" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/lolib_ic_top_share" android:scaleType="fitcenter" android:contentDescription="分享"/>
                <FrameLayout android:id="@+id/top_btn_open_docs_preview" android:background="?attr/selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="已打开文档">
                        <ImageView android:padding="12dp" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/lolib_ic_top_open_docs" android:scaleType="fitcenter" android:importantForAccessibility="2"/>
                        <TextView android:textSize="10sp" android:textColor="#000000" android:layout_gravity="center_horizontal" android:id="@+id/top_open_docs_count_preview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:importantForAccessibility="2"/>
                </FrameLayout>
        </LinearLayout>
        <FrameLayout android:id="@+id/top_toolbar_edit" android:background="@color/lolib_chrome_status_plate" android:visibility="gone" android:layout_width="match_parent" android:layout_height="@dimen/lolib_top_toolbar_content_height" android:paddingStart="@dimen/top_toolbar_edit_padding_start" android:paddingEnd="@dimen/top_toolbar_edit_padding_end">
                <TextView android:textSize="16sp" android:textStyle="0x00000001" android:textColor="#ffffff" android:gravity="center" android:layout_gravity="center" android:id="@+id/top_btn_done" android:background="@drawable/lolib_bg_top_done_button" android:paddingTop="6dp" android:paddingBottom="6dp" android:focusable="true" android:clickable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="72dp" android:text="完成" android:paddingStart="20dp" android:paddingEnd="20dp"/>
                <LinearLayout android:gravity="center_vertical" android:layout_gravity="center" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <ImageButton android:id="@+id/top_btn_undo" android:background="?attr/selectableItemBackgroundBorderless" android:padding="8dp" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/lolib_ic_top_undo" android:scaleType="fitcenter" android:contentDescription="撤销"/>
                        <ImageButton android:id="@+id/top_btn_redo" android:background="?attr/selectableItemBackgroundBorderless" android:padding="8dp" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/lolib_ic_top_redo" android:scaleType="fitcenter" android:contentDescription="恢复"/>
                </LinearLayout>
                <LinearLayout android:gravity="center_vertical" android:layout_gravity="center" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
                        <FrameLayout android:id="@+id/top_btn_open_docs_edit" android:background="?attr/selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="已打开文档">
                                <ImageView android:padding="12dp" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/lolib_ic_top_open_docs" android:scaleType="fitcenter" android:importantForAccessibility="2"/>
                                <TextView android:textSize="10sp" android:textColor="#000000" android:layout_gravity="center_horizontal" android:id="@+id/top_open_docs_count_edit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:importantForAccessibility="2"/>
                        </FrameLayout>
                        <ImageButton android:id="@+id/top_btn_close_edit" android:background="?attr/selectableItemBackgroundBorderless" android:padding="@dimen/doc_top_toolbar_close_icon_padding" android:layout_width="@dimen/doc_top_toolbar_close_size" android:layout_height="@dimen/doc_top_toolbar_close_size" android:src="@drawable/lolib_ic_top_close_edit" android:scaleType="centerinside" android:contentDescription="关闭编辑"/>
                </LinearLayout>
        </FrameLayout>
</LinearLayout>
