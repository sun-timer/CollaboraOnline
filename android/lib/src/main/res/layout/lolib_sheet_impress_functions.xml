<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/impress_function_sheet_root" android:background="#ffffff" android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/impress_function_tab_header" android:layout_width="match_parent" android:layout_height="48dp" android:paddingStart="8dp" android:paddingEnd="4dp">
                <HorizontalScrollView android:scrollbars="none" android:layout_width="0dp" android:layout_height="match_parent" android:fillViewport="false" android:layout_weight="1">
                        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/impress_function_tab_bar" android:layout_width="wrap_content" android:layout_height="match_parent"/>
                </HorizontalScrollView>
                <ImageView android:layout_gravity="center_vertical" android:layout_width="@dimen/function_panel_header_divider_width" android:layout_height="@dimen/function_panel_header_divider_height" android:src="@drawable/lolib_ic_function_panel_header_divider" android:contentDescription="@null" android:importantForAccessibility="no" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"/>
                <ImageButton android:id="@+id/impress_function_btn_ai" android:background="?attr/selectableItemBackgroundBorderless" android:padding="0dp" android:layout_width="@dimen/function_panel_header_action_btn_size" android:layout_height="@dimen/function_panel_header_action_btn_size" android:src="@drawable/lolib_ic_function_panel_ai_sparkle" android:scaleType="centerInside" android:contentDescription="AI功能"/>
                <ImageButton android:id="@+id/impress_function_btn_keyboard" android:background="?attr/selectableItemBackgroundBorderless" android:padding="0dp" android:layout_width="@dimen/function_panel_header_action_btn_size" android:layout_height="@dimen/function_panel_header_action_btn_size" android:src="@drawable/lolib_ic_function_panel_keyboard" android:scaleType="centerInside" android:contentDescription="键盘"/>
                <ImageButton android:id="@+id/impress_function_btn_collapse" android:background="?attr/selectableItemBackgroundBorderless" android:padding="0dp" android:layout_width="@dimen/function_panel_header_action_btn_size" android:layout_height="@dimen/function_panel_header_action_btn_size" android:src="@drawable/lolib_ic_function_panel_collapse" android:scaleType="centerInside" android:contentDescription="收起"/>
        </LinearLayout>
        <FrameLayout android:id="@+id/impress_function_tab_indicator_area" android:layout_width="match_parent" android:layout_height="4dp">
                <View android:layout_gravity="bottom" android:background="#e3e3e3" android:layout_width="match_parent" android:layout_height="1dp"/>
                <View android:layout_gravity="start|bottom" android:id="@+id/impress_function_tab_indicator" android:background="@drawable/lolib_bg_impress_tab_indicator" android:visibility="invisible" android:layout_width="24dp" android:layout_height="3dp"/>
        </FrameLayout>
        <androidx.core.widget.NestedScrollView android:id="@+id/impress_function_content_container" android:paddingTop="8dp" android:paddingBottom="16dp" android:scrollbars="vertical" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="0dp" android:fillViewport="false" android:layout_weight="1" android:overScrollMode="ifContentScrolls" android:paddingStart="16dp" android:paddingEnd="16dp"/>
        <include android:id="@+id/impress_function_font_picker_panel" android:visibility="gone" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" layout="@layout/lolib_sheet_font_picker"/>
</LinearLayout>
