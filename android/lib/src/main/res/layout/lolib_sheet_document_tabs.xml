<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/document_tabs_panel" android:background="@drawable/lolib_bg_document_tabs_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:elevation="12dp">
        <View android:id="@+id/document_tabs_status_plate" android:background="@color/lolib_chrome_status_plate" android:layout_width="match_parent" android:layout_height="0dp" android:minHeight="@dimen/lolib_status_plate_min_height" android:importantForAccessibility="no"/>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/tabs_sheet_header" android:background="@color/lolib_chrome_status_plate" android:layout_width="match_parent" android:layout_height="@dimen/function_sheet_header_height" android:paddingStart="@dimen/function_sheet_header_padding_h" android:paddingEnd="@dimen/function_sheet_header_padding_h">
                <View android:layout_width="@dimen/function_sheet_close_size" android:layout_height="@dimen/function_sheet_close_size"/>
                <TextView android:textSize="20sp" android:textColor="#101010" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:text="文档" android:layout_weight="1" android:fontFamily="sans-serif-medium"/>
                <ImageButton android:id="@+id/tabs_sheet_close" android:background="?attr/selectableItemBackgroundBorderless" android:padding="@dimen/function_sheet_close_icon_padding" android:layout_width="@dimen/function_sheet_close_size" android:layout_height="@dimen/function_sheet_close_size" android:src="@drawable/lolib_ic_dialog_close" android:scaleType="centerInside" android:contentDescription="关闭"/>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:paddingBottom="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp">
                <LinearLayout android:orientation="horizontal" android:background="@drawable/lolib_bg_document_tabs_tab_container" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_width="match_parent" android:layout_height="38dp" android:paddingStart="4dp" android:paddingEnd="4dp">
                        <TextView android:textSize="12sp" android:textColor="#101010" android:gravity="center" android:id="@+id/tabs_tab_opened" android:background="@drawable/lolib_bg_document_tabs_tab_active" android:layout_width="0dp" android:layout_height="match_parent" android:text="已打开" android:layout_weight="1"/>
                        <TextView android:textSize="12sp" android:textColor="#999999" android:gravity="center" android:id="@+id/tabs_tab_closed" android:background="@android:color/transparent" android:layout_width="0dp" android:layout_height="match_parent" android:text="最近关闭 (0)" android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout android:orientation="vertical" android:background="@drawable/lolib_bg_document_tabs_list_card" android:paddingTop="16dp" android:paddingBottom="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:paddingStart="16dp" android:paddingEnd="16dp">
                        <ScrollView android:scrollbars="none" android:layout_width="match_parent" android:layout_height="280dp" android:fillViewport="true" android:overScrollMode="never">
                                <LinearLayout android:orientation="vertical" android:id="@+id/tabs_list_container" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                        </ScrollView>
                </LinearLayout>
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/tabs_open_document" android:background="@drawable/lolib_bg_document_tabs_open_button" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="39dp" android:layout_marginTop="16dp">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/lolib_ic_tabs_open_folder" android:contentDescription="打开文档" android:layout_marginEnd="8dp"/>
                        <TextView android:textSize="12sp" android:textColor="#999999" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="打开文档"/>
                </LinearLayout>
        </LinearLayout>
</LinearLayout>
