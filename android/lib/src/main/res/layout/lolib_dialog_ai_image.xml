<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@drawable/lolib_bg_dialog_outline" android:paddingTop="20dp" android:paddingBottom="24dp" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="24dp" android:paddingEnd="24dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:textSize="20sp" android:textStyle="0x00000001" android:textColor="#1f1f1f" android:gravity="center" android:id="@+id/ai_image_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AI 图片"/>
                <ImageButton android:layout_gravity="top|end" android:id="@+id/ai_image_close_btn" android:background="?attr/selectableItemBackgroundBorderless" android:padding="8dp" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginTop="10dp" android:src="@drawable/lolib_ic_dialog_close" android:scaleType="centerinside" android:contentDescription="关闭" android:layout_marginEnd="16dp"/>
        </FrameLayout>
        <LinearLayout android:orientation="vertical" android:id="@+id/ai_image_input_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="16dp" android:layout_weight="1">
                <EditText android:textSize="16sp" android:textColor="#333333" android:textColorHint="#999999" android:gravity="top|start" android:id="@+id/ai_image_prompt_edit" android:background="@drawable/lolib_bg_outline_edit" android:paddingTop="16dp" android:paddingBottom="16dp" android:layout_width="match_parent" android:layout_height="0dp" android:hint="请输入图片的引导词" android:layout_weight="1" android:inputType="0x00024001" android:paddingStart="20dp" android:paddingEnd="20dp"/>
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/ai_image_ratio_card" android:background="@drawable/lolib_bg_outline_edit" android:paddingTop="10dp" android:paddingBottom="10dp" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp" android:paddingStart="16dp" android:paddingEnd="16dp">
                        <TextView android:textSize="14sp" android:textColor="#666666" android:layout_width="0dp" android:layout_height="wrap_content" android:text="图片比例" android:layout_weight="1"/>
                        <TextView android:textSize="16sp" android:textStyle="0x00000001" android:textColor="#1da8ff" android:id="@+id/ai_image_ratio_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1:1" android:layout_marginEnd="8dp"/>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/lolib_ic_arrow_down" android:contentDescription="选择比例"/>
                </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:id="@+id/ai_image_gallery_container" android:visibility="gone" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="16dp" android:layout_weight="1">
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                        <ImageView android:id="@+id/ai_image_main" android:background="@drawable/lolib_bg_outline_edit" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centercrop" android:contentDescription="生成图片预览"/>
                        <ProgressBar android:layout_gravity="center" android:id="@+id/ai_image_loading" android:visibility="gone" android:layout_width="48dp" android:layout_height="48dp"/>
                </FrameLayout>
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                        <ImageView android:id="@+id/ai_image_thumb_1" android:background="@drawable/lolib_bg_outline_edit" android:layout_width="0dp" android:layout_height="72dp" android:scaleType="centercrop" android:layout_weight="1" android:contentDescription="缩略图1" android:layout_marginEnd="8dp"/>
                        <ImageView android:id="@+id/ai_image_thumb_2" android:background="@drawable/lolib_bg_outline_edit" android:layout_width="0dp" android:layout_height="72dp" android:scaleType="centercrop" android:layout_weight="1" android:contentDescription="缩略图2" android:layout_marginEnd="8dp"/>
                        <ImageView android:id="@+id/ai_image_thumb_3" android:background="@drawable/lolib_bg_outline_edit" android:layout_width="0dp" android:layout_height="72dp" android:scaleType="centercrop" android:layout_weight="1" android:contentDescription="缩略图3"/>
                </LinearLayout>
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/ai_image_generate_btn" android:background="@drawable/lolib_bg_gradient_button_outline" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/lolib_ic_btn_generate" android:contentDescription="开始生成"/>
                <TextView android:textSize="18sp" android:textStyle="0x00000001" android:textColor="#ffffff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开始生成" android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/ai_image_done_row" android:visibility="gone" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp">
                <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/ai_image_regenerate_btn" android:background="@drawable/lolib_bg_outline_secondary_button" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="match_parent">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/lolib_ic_btn_regenerate" android:contentDescription="重新生成"/>
                        <TextView android:textSize="18sp" android:textColor="#333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="重新生成" android:layout_marginStart="8dp"/>
                </LinearLayout>
        </LinearLayout>
</LinearLayout>
