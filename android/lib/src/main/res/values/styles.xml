<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Default compact cell (calc object bar etc.) -->
    <style name="SelectionPopupButton">
        <item name="android:layout_width">62dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/lolib_bg_selection_popup_cell</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- Figma 245:7964 — equal-width cells in selection popup rows -->
    <style name="SelectionPopupButtonWeighted" parent="SelectionPopupButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="SelectionPopupButtonCompact" parent="SelectionPopupButton">
        <item name="android:layout_width">56dp</item>
    </style>

    <style name="SelectionPopupButtonIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:contentDescription">图标</item>
    </style>

    <style name="SelectionPopupButtonText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">10sp</item>
    </style>
</resources>
