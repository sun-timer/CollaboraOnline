<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 326:21176: horizontal colour gradient masked to white towards bottom. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle">
        <gradient android:angle="0" android:startColor="#F7E6FF" android:endColor="#DFF2FF" android:type="linear" />
        <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" />
    </shape></item>
    <item><shape android:shape="rectangle">
        <gradient android:angle="270" android:startColor="#00FFFFFF" android:endColor="#FFFFFFFF" android:type="linear" />
        <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" />
    </shape></item>
</layer-list>
