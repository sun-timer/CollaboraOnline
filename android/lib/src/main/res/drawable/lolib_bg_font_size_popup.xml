        <shape android:shape="rectangle">
            <solid android:color="#1A000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#ffffff" />
            <corners android:radius="16dp" />
