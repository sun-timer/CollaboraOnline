<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
        <item>
                <shape android:shape="rectangle">
                        <gradient android:startColor="#1da8ff" android:endColor="#dd00ce" android:angle="135" android:type="linear"/>
                        <corners android:radius="7dp"/>
                </shape>
        </item>
        <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                        <solid android:color="#ffffff"/>
                        <corners android:radius="5dp"/>
                </shape>
        </item>
        <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                        <gradient android:startColor="#141da8ff" android:endColor="#14dd00ce" android:angle="135" android:type="linear"/>
                        <corners android:radius="5dp"/>
                </shape>
        </item>
</layer-list>
