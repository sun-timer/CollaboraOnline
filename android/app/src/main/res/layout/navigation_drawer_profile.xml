<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/drawer_profile_header_padding_h"
        android:paddingTop="@dimen/drawer_profile_header_padding_v"
        android:paddingEnd="@dimen/drawer_profile_header_padding_h"
        android:paddingBottom="@dimen/drawer_profile_header_padding_v">

        <LinearLayout
            android:id="@+id/profileEntry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/profileAvatar"
                android:layout_width="@dimen/drawer_profile_avatar_size"
                android:layout_height="@dimen/drawer_profile_avatar_size"
                android:background="@drawable/bg_avatar_circle"
                android:contentDescription="@string/ai_profile_avatar"
                android:scaleType="centerCrop"
                android:src="@drawable/drawer_header" />

            <TextView
                android:id="@+id/profileNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/drawer_profile_avatar_name_gap"
                android:text="@string/ai_profile_name"
                android:textColor="#101010"
                android:textSize="@dimen/drawer_profile_name_text_size" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/profileEditButton"
            android:layout_width="@dimen/drawer_profile_edit_button_size"
            android:layout_height="@dimen/drawer_profile_edit_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ai_edit_nickname"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_profile_edit" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D8D8D8" />

</LinearLayout>
