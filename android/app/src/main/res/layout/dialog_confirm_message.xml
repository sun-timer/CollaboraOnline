<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/confirmDialogCard"
    android:layout_width="@dimen/rename_dialog_width"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rename_dialog_card"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingBottom="@dimen/rename_dialog_bottom_padding">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/rename_dialog_header_height"
        android:paddingStart="@dimen/rename_dialog_header_padding_horizontal"
        android:paddingEnd="@dimen/rename_dialog_header_padding_horizontal">

        <View
            android:layout_width="@dimen/rename_dialog_close_size"
            android:layout_height="@dimen/rename_dialog_close_size"
            android:layout_gravity="start|center_vertical"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/confirmDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#1F1F1F"
            android:textSize="@dimen/rename_dialog_title_size"
            android:fontFamily="sans-serif-medium" />

        <ImageButton
            android:id="@+id/confirmDialogClose"
            android:layout_width="@dimen/rename_dialog_close_size"
            android:layout_height="@dimen/rename_dialog_close_size"
            android:layout_gravity="end|center_vertical"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_cancel"
            android:padding="@dimen/rename_dialog_close_padding"
            android:scaleType="centerInside"
            android:src="@drawable/ic_create_dialog_close" />
    </FrameLayout>

    <TextView
        android:id="@+id/confirmDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="4dp"
        android:paddingStart="@dimen/rename_dialog_content_padding"
        android:paddingEnd="@dimen/rename_dialog_content_padding"
        android:textColor="#333333"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rename_dialog_buttons_margin_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/rename_dialog_buttons_padding_horizontal"
        android:paddingTop="@dimen/rename_dialog_buttons_padding_vertical"
        android:paddingEnd="@dimen/rename_dialog_buttons_padding_horizontal"
        android:paddingBottom="@dimen/rename_dialog_buttons_padding_vertical">

        <TextView
            android:id="@+id/confirmDialogCancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/rename_dialog_btn_height"
            android:layout_weight="1"
            android:background="@drawable/bg_rename_dialog_btn_cancel"
            android:gravity="center"
            android:text="@string/action_cancel"
            android:textColor="#E5000000"
            android:textSize="@dimen/rename_dialog_btn_text_size" />

        <Space
            android:layout_width="@dimen/rename_dialog_btn_gap"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/confirmDialogConfirm"
            android:layout_width="0dp"
            android:layout_height="@dimen/rename_dialog_btn_height"
            android:layout_weight="1"
            android:background="@drawable/bg_rename_dialog_btn_confirm"
            android:gravity="center"
            android:text="@string/action_confirm"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/rename_dialog_btn_text_size" />
    </LinearLayout>
</LinearLayout>
