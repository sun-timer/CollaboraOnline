<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:theme="@style/LibreOfficeTheme.Base" android:id="@+id/drawer_layout" android:focusable="true" android:focusableInTouchMode="true" android:layout_width="match_parent" android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/overview_coordinator_layout" android:background="#ffffff" android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout android:orientation="vertical" android:id="@+id/homeTopBar" android:background="@color/lolib_chrome_status_plate" android:layout_width="0dp" android:layout_height="wrap_content" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
                        <View android:id="@+id/home_top_status_plate" android:background="@color/lolib_chrome_status_plate" android:layout_width="match_parent" android:layout_height="0dp" android:minHeight="@dimen/lolib_status_plate_min_height" android:importantForAccessibility="2"/>
                        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/home_top_content_row" android:layout_width="match_parent" android:layout_height="@dimen/lolib_top_toolbar_content_height" android:paddingStart="@dimen/home_top_bar_padding_start" android:paddingEnd="@dimen/home_top_bar_padding_end">
                                <ImageView android:id="@+id/homeLeftIcon" android:background="@drawable/bg_avatar_circle" android:layout_width="@dimen/home_top_avatar_size" android:layout_height="@dimen/home_top_avatar_size" android:src="@drawable/drawer_header" android:scaleType="centerCrop" android:contentDescription="@string/ai_profile_name"/>
                                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/homeSearchContainer" android:background="@drawable/bg_home_search" android:layout_width="0dp" android:layout_height="@dimen/home_top_search_height" android:layout_weight="1" android:paddingStart="@dimen/home_top_search_padding_h" android:paddingEnd="@dimen/home_top_search_padding_h" android:layout_marginStart="@dimen/home_top_avatar_search_gap" android:layout_marginEnd="@dimen/home_top_search_open_gap">
                                        <ImageView android:layout_width="@dimen/home_top_search_icon_size" android:layout_height="@dimen/home_top_search_icon_size" android:src="@drawable/ic_home_search" android:contentDescription="@string/search_label" app:tint="#999999"/>
                                        <EditText android:textSize="16sp" android:textColor="#333333" android:textColorHint="#999999" android:id="@+id/homeSearchInput" android:background="@android:color/transparent" android:padding="0dp" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="@string/home_search_hint" android:maxLines="1" android:layout_weight="1" android:inputType="text" android:imeOptions="actionSearch" android:layout_marginStart="@dimen/home_top_search_icon_text_gap"/>
                                </LinearLayout>
                                <ImageView android:id="@+id/homeOpenFileButton" android:padding="12dp" android:layout_width="@dimen/home_top_open_file_touch_size" android:layout_height="@dimen/home_top_open_file_touch_size" android:src="@drawable/ic_home_folder" android:scaleType="centerInside" android:contentDescription="@string/open" app:tint="#434343"/>
                        </LinearLayout>
                </LinearLayout>
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/recentsHeaderRow" android:background="#ffffff" android:layout_width="0dp" android:layout_height="56dp" android:paddingStart="16dp" android:paddingEnd="16dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/homeTopBar">
                        <TextView android:textSize="16sp" android:textStyle="bold" android:textColor="#6f7378" android:id="@+id/header_recents" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/title_recents" android:layout_weight="1"/>
                        <ImageView android:id="@+id/recent_list_or_grid" android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="@string/list_view" app:srcCompat="@drawable/ic_list_black_24dp" app:tint="#6f7378"/>
                </LinearLayout>
                <FrameLayout android:id="@+id/recentContentContainer" android:background="#ffffff" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/recentsHeaderRow">
                        <androidx.recyclerview.widget.RecyclerView android:id="@+id/list_recent" android:paddingBottom="@dimen/home_recent_list_bottom_padding" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="8dp" android:paddingEnd="8dp"/>
                        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/emptyRecentState" android:paddingBottom="80dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="20dp" android:paddingEnd="20dp">
                                <ImageView android:layout_width="268dp" android:layout_height="190dp" android:src="@drawable/ic_home_empty_recent_art" android:scaleType="fitCenter" android:contentDescription="@string/no_recent_items"/>
                                <TextView android:textSize="14sp" android:textColor="#4d000000" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_empty_recent_title"/>
                                <TextView android:textSize="14sp" android:textColor="#4d000000" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/home_empty_recent_subtitle"/>
                        </LinearLayout>
                        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@+id/emptySearchState" android:paddingBottom="100dp" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="20dp" android:paddingEnd="20dp">
                                <ImageView android:layout_width="268dp" android:layout_height="190dp" android:src="@drawable/ic_home_search_empty" android:scaleType="fitCenter" android:contentDescription="@string/home_empty_search_title"/>
                                <TextView android:textSize="14sp" android:textColor="#4d000000" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_empty_search_title"/>
                                <Button android:textSize="16sp" android:textColor="#e5000000" android:id="@+id/retrySearchButton" android:background="@drawable/bg_home_retry" android:padding="0dp" android:layout_width="134dp" android:layout_height="35dp" android:layout_marginTop="62dp" android:minWidth="0dp" android:minHeight="0dp" android:text="@string/home_retry" android:insetTop="0dp" android:insetBottom="0dp" android:textAllCaps="false"/>
                        </LinearLayout>
                        <TextView android:id="@+id/no_recent_items_msg" android:visibility="gone" android:layout_width="1dp" android:layout_height="1dp"/>
                </FrameLayout>
                <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/homeFabLayer" android:clipChildren="false" android:clipToPadding="false" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
                        <FrameLayout android:id="@+id/newDocOverlay" android:background="@android:color/transparent" android:focusable="true" android:visibility="gone" android:clickable="true" android:clipChildren="false" android:clipToPadding="false" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                        <View android:id="@+id/homeFabAnchor" android:visibility="invisible" android:layout_width="@dimen/home_fab_size" android:layout_height="@dimen/home_fab_size" android:layout_marginBottom="@dimen/home_fab_margin_bottom" android:importantForAccessibility="2" android:layout_marginEnd="@dimen/home_fab_margin_end" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
                        <LinearLayout android:orientation="vertical" android:id="@+id/newDocMenuCard" android:background="@drawable/bg_new_doc_menu_card" android:focusable="true" android:visibility="gone" android:clickable="true" android:clipChildren="false" android:clipToPadding="false" android:layout_width="@dimen/home_new_doc_menu_width" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/home_new_doc_menu_above_fab_gap" android:paddingStart="@dimen/home_new_doc_menu_card_padding_horizontal" android:paddingEnd="@dimen/home_new_doc_menu_card_padding_horizontal" android:elevation="@dimen/home_new_doc_menu_elevation" android:outlineProvider="0" app:layout_constraintBottom_toTopOf="@+id/homeFabAnchor" app:layout_constraintEnd_toEndOf="@+id/homeFabAnchor">
                                <include/>
                        </LinearLayout>
                        <FrameLayout android:id="@+id/editFAB" android:background="@android:color/transparent" android:focusable="true" android:clickable="true" android:clipChildren="false" android:clipToPadding="false" android:layout_width="0dp" android:layout_height="0dp" android:elevation="10dp" app:layout_constraintBottom_toBottomOf="@+id/homeFabAnchor" app:layout_constraintEnd_toEndOf="@+id/homeFabAnchor" app:layout_constraintStart_toStartOf="@+id/homeFabAnchor" app:layout_constraintTop_toTopOf="@+id/homeFabAnchor">
                                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_home_fab" android:scaleType="fitXY" android:contentDescription="@string/create_new_document_title"/>
                        </FrameLayout>
                        <FrameLayout android:id="@+id/newDocCloseButton" android:background="@android:color/transparent" android:focusable="true" android:visibility="gone" android:clickable="true" android:clipChildren="false" android:clipToPadding="false" android:layout_width="0dp" android:layout_height="0dp" android:elevation="11dp" app:layout_constraintBottom_toBottomOf="@+id/homeFabAnchor" app:layout_constraintEnd_toEndOf="@+id/homeFabAnchor" app:layout_constraintStart_toStartOf="@+id/homeFabAnchor" app:layout_constraintTop_toTopOf="@+id/homeFabAnchor">
                                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_new_doc_close_fab" android:scaleType="fitXY" android:contentDescription="@string/action_cancel"/>
                        </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout android:layout_gravity="start" android:id="@+id/navigation_drawer" android:background="#ffffff" android:layout_width="@dimen/ai_drawer_panel_width" android:layout_height="match_parent">
                <include/>
        </FrameLayout>
</androidx.drawerlayout.widget.DrawerLayout>
