<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:theme="@style/LibreOfficeTheme.Base"
    style="@style/LibreOfficeTheme.Base">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/overview_coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">

        <LinearLayout
            android:id="@+id/homeTopBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/lolib_chrome_status_plate"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Figma 556:21271：状态栏与顶栏共用 #F2F2F2 底板 -->
            <View
                android:id="@+id/home_top_status_plate"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:minHeight="@dimen/lolib_status_plate_min_height"
                android:background="@color/lolib_chrome_status_plate"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/home_top_content_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lolib_top_toolbar_content_height"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/home_top_bar_padding_start"
                android:paddingEnd="@dimen/home_top_bar_padding_end">

            <ImageView
                android:id="@+id/homeLeftIcon"
                android:layout_width="@dimen/home_top_avatar_size"
                android:layout_height="@dimen/home_top_avatar_size"
                android:background="@drawable/bg_avatar_circle"
                android:contentDescription="@string/ai_profile_name"
                android:scaleType="centerCrop"
                android:src="@drawable/drawer_header" />

            <LinearLayout
                android:id="@+id/homeSearchContainer"
                android:layout_width="0dp"
                android:layout_height="@dimen/home_top_search_height"
                android:layout_marginStart="@dimen/home_top_avatar_search_gap"
                android:layout_marginEnd="@dimen/home_top_search_open_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_home_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/home_top_search_padding_h"
                android:paddingEnd="@dimen/home_top_search_padding_h">

                <ImageView
                    android:layout_width="@dimen/home_top_search_icon_size"
                    android:layout_height="@dimen/home_top_search_icon_size"
                    android:contentDescription="@string/search_label"
                    android:src="@drawable/ic_home_search"
                    app:tint="#999999" />

                <EditText
                    android:id="@+id/homeSearchInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/home_top_search_icon_text_gap"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/home_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:textColor="#333333"
                    android:textColorHint="#999999"
                    android:textSize="16sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/homeOpenFileButton"
                android:layout_width="@dimen/home_top_open_file_touch_size"
                android:layout_height="@dimen/home_top_open_file_touch_size"
                android:contentDescription="@string/open"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_home_folder"
                app:tint="#434343" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/recentsHeaderRow"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/homeTopBar">

            <TextView
                android:id="@+id/header_recents"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_recents"
                android:textColor="#6F7378"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/recent_list_or_grid"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/list_view"
                app:srcCompat="@drawable/ic_list_black_24dp"
                app:tint="#6F7378" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/recentContentContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recentsHeaderRow">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_recent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="@dimen/home_recent_list_bottom_padding"
                android:clipToPadding="false" />

            <LinearLayout
                android:id="@+id/emptyRecentState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="80dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:contentDescription="@string/no_recent_items"
                    android:src="@drawable/ic_home_empty_recent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/home_empty_recent_title"
                    android:textColor="#B0B3B8"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/home_empty_recent_subtitle"
                    android:textColor="#B0B3B8"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/emptySearchState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="100dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:alpha="0.34"
                    android:contentDescription="@string/home_empty_search_title"
                    android:src="@drawable/dummy_page" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/home_empty_search_title"
                    android:textColor="#B0B3B8"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/retrySearchButton"
                    android:layout_width="190dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="30dp"
                    android:background="@drawable/bg_ai_btn_cancel"
                    android:text="@string/home_retry"
                    android:textAllCaps="false"
                    android:textColor="#202124"
                    android:textSize="20sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/no_recent_items_msg"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/homeFabLayer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:id="@+id/newDocOverlay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Figma 117:5343 — menu above FAB anchor, right edge aligned (extends left) -->
            <View
                android:id="@+id/homeFabAnchor"
                android:layout_width="@dimen/home_fab_size"
                android:layout_height="@dimen/home_fab_size"
                android:importantForAccessibility="no"
                android:visibility="invisible"
                android:layout_marginEnd="@dimen/home_fab_margin_end"
                android:layout_marginBottom="@dimen/home_fab_margin_bottom"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/newDocMenuCard"
                android:layout_width="@dimen/home_new_doc_menu_width"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_new_doc_menu_card"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="@dimen/home_new_doc_menu_elevation"
                android:focusable="true"
                android:orientation="vertical"
                android:outlineProvider="background"
                android:paddingStart="@dimen/home_new_doc_menu_card_padding_horizontal"
                android:paddingEnd="@dimen/home_new_doc_menu_card_padding_horizontal"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/home_new_doc_menu_above_fab_gap"
                app:layout_constraintBottom_toTopOf="@id/homeFabAnchor"
                app:layout_constraintEnd_toEndOf="@id/homeFabAnchor">

                <include layout="@layout/include_new_doc_menu_rows" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/editFAB"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="10dp"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="@id/homeFabAnchor"
                app:layout_constraintEnd_toEndOf="@id/homeFabAnchor"
                app:layout_constraintStart_toStartOf="@id/homeFabAnchor"
                app:layout_constraintTop_toTopOf="@id/homeFabAnchor">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/create_new_document_title"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_home_fab" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/newDocCloseButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="11dp"
                android:focusable="true"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/homeFabAnchor"
                app:layout_constraintEnd_toEndOf="@id/homeFabAnchor"
                app:layout_constraintStart_toStartOf="@id/homeFabAnchor"
                app:layout_constraintTop_toTopOf="@id/homeFabAnchor">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/action_cancel"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_new_doc_close_fab" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/navigation_drawer"
        android:layout_width="@dimen/ai_drawer_panel_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF">

        <include layout="@layout/navigation_drawer_panel" />

    </FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>
