<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F3F3"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/profileBackButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_back"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_model_config_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/ai_profile_edit_title"
            android:textColor="#101010"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="@dimen/dialog_shell_padding_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/dialog_shell_padding_horizontal"
        android:background="@drawable/bg_ai_profile_card"
        android:maxWidth="@dimen/content_max_width"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/profileAvatarRow"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ai_profile_avatar"
                android:textColor="#101010"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/profileAvatarValue"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/ai_profile_avatar"
                android:scaleType="centerCrop"
                android:src="@drawable/drawer_header" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/open"
                android:src="@drawable/ic_profile_chevron" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E3E4" />

        <LinearLayout
            android:id="@+id/profileNicknameRow"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ai_profile_name"
                android:textColor="#101010"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/profileNicknameValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/profile_nickname_max_width"
                android:singleLine="true"
                android:textColor="#6D7278"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/open"
                android:src="@drawable/ic_profile_chevron" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
