<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/file_item_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/file_icon_desc"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_file_type_writer" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/file_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#202124"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="文档名称" />

        <TextView
            android:id="@+id/file_item_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#9AA0A6"
            android:textSize="14sp"
            tools:text="2026/3/25" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp">

        <ImageView
            android:id="@+id/file_actions_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_more_action_button"
            android:contentDescription="@string/file_actions_icon_desc"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_dots" />
    </FrameLayout>
</LinearLayout>
