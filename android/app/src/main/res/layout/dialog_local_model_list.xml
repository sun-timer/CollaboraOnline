<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/localModelListDialogInner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/local_model_list_header_height"
        android:paddingStart="@dimen/local_model_list_header_padding_h"
        android:paddingEnd="@dimen/local_model_list_header_padding_h">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:visibility="invisible" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/local_model_title"
            android:textColor="#1F1F1F"
            android:textSize="@dimen/local_model_list_title_size"
            android:fontFamily="sans-serif-medium" />

        <ImageButton
            android:id="@+id/localModelListCloseButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_cancel"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_create_dialog_close" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/localModelListScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/localModelListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/local_model_list_content_padding"
            android:paddingTop="@dimen/local_model_list_content_padding"
            android:paddingEnd="@dimen/local_model_list_content_padding"
            android:paddingBottom="@dimen/local_model_list_content_padding" />
    </ScrollView>

    <TextView
        android:id="@+id/localModelListConfirmButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/local_model_list_confirm_height"
        android:layout_marginStart="@dimen/local_model_list_confirm_margin_h"
        android:layout_marginTop="@dimen/local_model_list_confirm_margin_v"
        android:layout_marginEnd="@dimen/local_model_list_confirm_margin_h"
        android:layout_marginBottom="@dimen/local_model_list_confirm_margin_v"
        android:background="@drawable/bg_local_model_confirm_btn"
        android:gravity="center"
        android:text="@string/action_confirm"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />
</LinearLayout>
