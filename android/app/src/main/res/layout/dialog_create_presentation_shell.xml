<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/createDialogRoot" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/createDialogCard" android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/bottom_sheet_margin_horizontal"
        android:background="@drawable/bg_create_file_bottom_sheet" android:clickable="true" android:focusable="true">
        <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="20dp">
                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="54dp" android:paddingHorizontal="12dp">
                    <View android:layout_width="48dp" android:layout_height="48dp"/>
                    <TextView android:id="@+id/createTitle" android:text="创建演示" android:textColor="#1F2329" android:textSize="18sp" android:textStyle="bold" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                    <ImageButton android:id="@+id/closeButton" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:scaleType="fitCenter" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_create_dialog_close" android:contentDescription="@string/action_cancel"/>
                </LinearLayout>
                <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="标题" android:textSize="16sp" android:textColor="#1F2329"/>
                    <EditText android:id="@+id/fileName" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/bg_create_file_input" android:paddingHorizontal="12dp" android:textSize="14sp" android:hint="请输入文件名称" android:singleLine="true" android:inputType="text" android:imeOptions="actionNext"/>
                    <TextView android:id="@+id/overwriteWarning" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/>
                    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="12dp" android:background="@drawable/bg_create_file_ai_row">
                        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="32dp">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_ai_sparkle" android:importantForAccessibility="no"/>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="内容使用AI生成" android:textSize="14sp" android:textColor="#1F2329" android:layout_marginStart="6dp"/>
                            <FrameLayout android:id="@+id/aiSwitch" android:layout_width="41dp" android:layout_height="24dp" android:clickable="true" android:focusable="true" android:contentDescription="内容使用AI生成" android:background="@drawable/bg_ai_switch_track_off">
                                <View android:id="@+id/aiSwitchThumb" android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="2.5dp" android:background="@drawable/bg_ai_switch_thumb_circle"/>
                            </FrameLayout>
                        </LinearLayout>
                        <LinearLayout android:id="@+id/pptCreateOptions" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                            <TextView android:id="@+id/pptCreateMode" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="10dp" android:background="@drawable/bg_create_file_input" android:text="快速生成" android:textSize="14sp" android:textColor="#1F2329" android:clickable="true" android:focusable="true" android:drawableEnd="@drawable/lolib_ic_chevron_down" android:drawablePadding="4dp"/>
                            <TextView android:id="@+id/pptCreateDocument" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:background="@drawable/bg_create_file_input" android:text="选择 TXT / DOCX / PDF 文件" android:textSize="14sp" android:visibility="gone" android:clickable="true" android:focusable="true"/>
                            <EditText android:id="@+id/aiPromptInput" android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginTop="8dp" android:gravity="top|start" android:background="@drawable/bg_create_file_input" android:padding="12dp" android:textSize="14sp" android:textColor="#1F2329" android:textColorHint="#A2A9B2" android:hint="请输入PPT主题和要求" android:inputType="textMultiLine|textCapSentences" android:maxLength="150000"/>
                            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="8dp">
                                <TextView android:id="@+id/pptCreatePages" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/lolib_bg_impress_ppt_pill" android:text="11-20页" android:gravity="center_vertical" android:textSize="13sp" android:textColor="#333333" android:maxLines="1" android:ellipsize="end" android:paddingStart="8dp" android:paddingEnd="6dp" android:drawableEnd="@drawable/lolib_ic_chevron_down" android:drawablePadding="2dp" android:clickable="true" android:focusable="true"/>
                                <TextView android:id="@+id/pptCreateAudience" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/lolib_bg_impress_ppt_pill" android:text="大众" android:gravity="center_vertical" android:textSize="13sp" android:textColor="#333333" android:maxLines="1" android:ellipsize="end" android:paddingStart="8dp" android:paddingEnd="6dp" android:drawableEnd="@drawable/lolib_ic_chevron_down" android:drawablePadding="2dp" android:clickable="true" android:focusable="true"/>
                                <TextView android:id="@+id/pptCreateStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/lolib_bg_impress_ppt_pill" android:text="学术报告" android:gravity="center_vertical" android:textSize="13sp" android:textColor="#333333" android:maxLines="1" android:ellipsize="end" android:paddingStart="8dp" android:paddingEnd="6dp" android:drawableEnd="@drawable/lolib_ic_chevron_down" android:drawablePadding="2dp" android:clickable="true" android:focusable="true"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:id="@+id/createButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="16dp" android:background="@drawable/bg_create_file_button" android:gravity="center" android:text="生成和创建" android:textSize="16sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
