<?xml version="1.0" encoding="utf-8"?>
<!-- Shell only: panel_ai_model_config is inflated into aiModelConfigPanelHost in code.
     Do NOT use <include> here — findViewById succeeds but the panel may not paint (gray screen). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_ai_model_config_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/aiModelConfigPanelHost"
        android:layout_width="@dimen/ai_drawer_panel_width"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true" />

    <View
        android:id="@+id/aiModelConfigScrim"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="#4D000000"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
