<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/renameDialogCard" android:background="@drawable/bg_rename_dialog_card" android:paddingBottom="@dimen/rename_dialog_bottom_padding" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxWidth="@dimen/dialog_content_max_width" android:elevation="8dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="@dimen/rename_dialog_header_height" android:paddingStart="@dimen/rename_dialog_header_padding_horizontal" android:paddingEnd="@dimen/rename_dialog_header_padding_horizontal">
                <View android:layout_gravity="center" android:visibility="invisible" android:layout_width="@dimen/rename_dialog_close_size" android:layout_height="@dimen/rename_dialog_close_size"/>
                <TextView android:textSize="@dimen/rename_dialog_title_size" android:textColor="#1f1f1f" android:gravity="center" android:id="@+id/renameDialogTitle" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/action_rename" android:fontFamily="sans-serif-medium"/>
                <ImageButton android:layout_gravity="center" android:id="@+id/renameDialogClose" android:background="@android:color/transparent" android:padding="@dimen/rename_dialog_close_padding" android:layout_width="@dimen/rename_dialog_close_size" android:layout_height="@dimen/rename_dialog_close_size" android:src="@drawable/ic_create_dialog_close" android:scaleType="centerinside" android:contentDescription="@string/action_cancel"/>
        </FrameLayout>
        <LinearLayout android:orientation="vertical" android:padding="@dimen/rename_dialog_content_padding" android:layout_width="match_parent" android:layout_height="wrap_content">
                <EditText android:textSize="@dimen/rename_dialog_input_label_size" android:textColor="#101010" android:gravity="center_vertical" android:id="@+id/renameFileInput" android:background="@drawable/bg_rename_dialog_input" android:paddingTop="@dimen/rename_dialog_input_padding_vertical" android:paddingBottom="@dimen/rename_dialog_input_padding_vertical" android:layout_width="match_parent" android:layout_height="@dimen/rename_dialog_input_height" android:singleLine="true" android:inputType="text" android:imeOptions="actionDone" android:textCursorDrawable="@drawable/bg_rename_dialog_input_cursor" android:paddingStart="@dimen/rename_dialog_input_padding_horizontal" android:paddingEnd="@dimen/rename_dialog_input_padding_horizontal"/>
        </LinearLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="@dimen/rename_dialog_buttons_padding_vertical" android:paddingBottom="@dimen/rename_dialog_buttons_padding_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/rename_dialog_buttons_padding_horizontal" android:paddingEnd="@dimen/rename_dialog_buttons_padding_horizontal">
                <TextView android:textSize="@dimen/rename_dialog_btn_text_size" android:textColor="#e5000000" android:gravity="center" android:id="@+id/renameDialogCancel" android:background="@drawable/bg_rename_dialog_btn_cancel" android:layout_width="0dp" android:layout_height="@dimen/rename_dialog_btn_height" android:text="@string/action_cancel" android:layout_weight="1"/>
                <Space android:layout_width="@dimen/rename_dialog_btn_gap" android:layout_height="1dp"/>
                <TextView android:textSize="@dimen/rename_dialog_btn_text_size" android:textColor="#ffffff" android:gravity="center" android:id="@+id/renameDialogConfirm" android:background="@drawable/bg_rename_dialog_btn_confirm" android:layout_width="0dp" android:layout_height="@dimen/rename_dialog_btn_height" android:text="@string/action_confirm" android:layout_weight="1"/>
        </LinearLayout>
</LinearLayout>
