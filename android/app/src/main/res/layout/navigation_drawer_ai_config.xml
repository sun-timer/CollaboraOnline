<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/aiConfigCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/drawer_ai_card_margin_h"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/drawer_ai_card_margin_h"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_ai_config_card"
        android:orientation="vertical"
        android:paddingStart="@dimen/drawer_ai_card_padding_h"
        android:paddingTop="@dimen/drawer_ai_card_padding_v"
        android:paddingEnd="@dimen/drawer_ai_card_padding_h"
        android:paddingBottom="@dimen/drawer_ai_card_padding_v">

        <LinearLayout
            android:id="@+id/aiConfigHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/aiConfigIcon"
                android:layout_width="@dimen/drawer_ai_header_icon_size"
                android:layout_height="@dimen/drawer_ai_header_icon_size"
                android:contentDescription="@string/ai_model_config_title"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ai_config_header" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_model_config_title"
                    android:textColor="#101010"
                    android:textSize="@dimen/drawer_ai_title_text_size" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/ai_model_config_desc"
                    android:textColor="#6A6A6A"
                    android:textSize="@dimen/drawer_ai_desc_text_size" />
            </LinearLayout>

            <ImageView
                android:id="@+id/aiConfigExpandToggle"
                android:layout_width="@dimen/drawer_ai_config_expand_chevron_size"
                android:layout_height="@dimen/drawer_ai_config_expand_chevron_size"
                android:contentDescription="@string/ai_model_config_title"
                android:scaleType="centerInside"
                android:src="@drawable/ic_ai_config_chevron_up" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aiConfigExpandableBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1A000000" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ai_model_select_hint"
                android:textColor="#6A6A6A"
                android:textSize="@dimen/drawer_ai_hint_text_size" />

            <LinearLayout
                android:id="@+id/modelItemBase"
                android:layout_width="match_parent"
                android:layout_height="@dimen/drawer_model_row_height"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_model_item_selected"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/drawer_model_row_padding_h"
                android:paddingEnd="@dimen/drawer_model_row_padding_h">

                <ImageView
                    android:layout_width="@dimen/drawer_model_icon_size"
                    android:layout_height="@dimen/drawer_model_icon_size"
                    android:contentDescription="@string/ai_model_basic"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_model_base" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/drawer_model_icon_text_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_model_basic"
                        android:textColor="#333333"
                        android:textSize="@dimen/drawer_model_title_text_size" />

                    <TextView
                        android:id="@+id/modelBaseValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/drawer_model_text_gap"
                        android:text="@string/ai_model_unset"
                        android:textColor="#6A6A6A"
                        android:textSize="@dimen/drawer_model_value_text_size" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/modelBaseArrow"
                    android:layout_width="@dimen/drawer_model_chevron_size"
                    android:layout_height="@dimen/drawer_model_chevron_size"
                    android:contentDescription="@string/open"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/modelItemThink"
                android:layout_width="match_parent"
                android:layout_height="@dimen/drawer_model_row_height"
                android:layout_marginTop="@dimen/drawer_model_row_gap"
                android:background="@drawable/bg_model_item"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/drawer_model_row_padding_h"
                android:paddingEnd="@dimen/drawer_model_row_padding_h">

                <ImageView
                    android:layout_width="@dimen/drawer_model_icon_size"
                    android:layout_height="@dimen/drawer_model_icon_size"
                    android:contentDescription="@string/ai_model_think"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_model_think" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/drawer_model_icon_text_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_model_think"
                        android:textColor="#333333"
                        android:textSize="@dimen/drawer_model_title_text_size" />

                    <TextView
                        android:id="@+id/modelThinkValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/drawer_model_text_gap"
                        android:text="@string/ai_model_unset"
                        android:textColor="#6A6A6A"
                        android:textSize="@dimen/drawer_model_value_text_size" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/modelThinkArrow"
                    android:layout_width="@dimen/drawer_model_chevron_size"
                    android:layout_height="@dimen/drawer_model_chevron_size"
                    android:contentDescription="@string/open"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/modelItemImage"
                android:layout_width="match_parent"
                android:layout_height="@dimen/drawer_model_row_height"
                android:layout_marginTop="@dimen/drawer_model_row_gap"
                android:background="@drawable/bg_model_item"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/drawer_model_row_padding_h"
                android:paddingEnd="@dimen/drawer_model_row_padding_h">

                <ImageView
                    android:layout_width="@dimen/drawer_model_icon_size"
                    android:layout_height="@dimen/drawer_model_icon_size"
                    android:contentDescription="@string/ai_model_image"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_model_image" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/drawer_model_icon_text_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_model_image"
                        android:textColor="#333333"
                        android:textSize="@dimen/drawer_model_title_text_size" />

                    <TextView
                        android:id="@+id/modelImageValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/drawer_model_text_gap"
                        android:text="@string/ai_model_unset"
                        android:textColor="#6A6A6A"
                        android:textSize="@dimen/drawer_model_value_text_size" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/modelImageArrow"
                    android:layout_width="@dimen/drawer_model_chevron_size"
                    android:layout_height="@dimen/drawer_model_chevron_size"
                    android:contentDescription="@string/open"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/modelItemVision"
                android:layout_width="match_parent"
                android:layout_height="@dimen/drawer_model_row_height"
                android:layout_marginTop="@dimen/drawer_model_row_gap"
                android:background="@drawable/bg_model_item"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/drawer_model_row_padding_h"
                android:paddingEnd="@dimen/drawer_model_row_padding_h">

                <ImageView
                    android:layout_width="@dimen/drawer_model_icon_size"
                    android:layout_height="@dimen/drawer_model_icon_size"
                    android:contentDescription="@string/ai_model_vision"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_model_vision" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/drawer_model_icon_text_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_model_vision"
                        android:textColor="#333333"
                        android:textSize="@dimen/drawer_model_title_text_size" />

                    <TextView
                        android:id="@+id/modelVisionValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/drawer_model_text_gap"
                        android:text="@string/ai_model_unset"
                        android:textColor="#6A6A6A"
                        android:textSize="@dimen/drawer_model_value_text_size" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/modelVisionArrow"
                    android:layout_width="@dimen/drawer_model_chevron_size"
                    android:layout_height="@dimen/drawer_model_chevron_size"
                    android:contentDescription="@string/open"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ai_local_model"
                android:textColor="#6A6A6A"
                android:textSize="@dimen/drawer_ai_hint_text_size" />

            <LinearLayout
                android:id="@+id/localModelRow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/drawer_model_row_height"
                android:layout_marginTop="@dimen/drawer_model_row_gap"
                android:background="@drawable/bg_model_item"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/drawer_model_row_padding_h"
                android:paddingEnd="@dimen/drawer_model_row_padding_h">

                <ImageView
                    android:layout_width="@dimen/drawer_model_icon_size"
                    android:layout_height="@dimen/drawer_model_icon_size"
                    android:contentDescription="@string/ai_local_inference"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_model_local_inference" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/drawer_model_icon_text_gap"
                    android:layout_weight="1"
                    android:text="@string/ai_local_inference"
                    android:textColor="#333333"
                    android:textSize="@dimen/drawer_model_title_text_size" />

                <TextView
                    android:id="@+id/localInstallButton"
                    android:layout_width="92dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_local_install_btn"
                    android:gravity="center"
                    android:text="@string/install"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/localModelInstalledCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/drawer_model_row_gap"
                android:background="@drawable/bg_model_item"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/localModelInstalledPrimaryRow"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/drawer_model_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/drawer_model_row_padding_h"
                    android:paddingEnd="@dimen/drawer_model_row_padding_h">

                    <ImageView
                        android:layout_width="@dimen/drawer_model_icon_size"
                        android:layout_height="@dimen/drawer_model_icon_size"
                        android:contentDescription="@string/ai_local_inference"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_model_local_inference" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/drawer_model_icon_text_gap"
                        android:layout_weight="1"
                        android:text="@string/ai_local_inference"
                        android:textColor="#333333"
                        android:textSize="@dimen/drawer_model_title_text_size" />

                    <TextView
                        android:id="@+id/localInstalledBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="@string/local_model_installed_short"
                        android:textColor="#FA6200"
                        android:textSize="@dimen/drawer_model_title_text_size" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/drawer_model_divider_margin_h"
                    android:layout_marginEnd="@dimen/drawer_model_divider_margin_h"
                    android:background="@drawable/bg_drawer_model_divider" />

                <LinearLayout
                    android:id="@+id/localModelListRow"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/drawer_model_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/drawer_model_indented_text_start"
                    android:paddingEnd="@dimen/drawer_model_row_padding_h">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ai_local_model_list"
                        android:textColor="#333333"
                        android:textSize="@dimen/drawer_model_title_text_size" />

                    <ImageView
                        android:layout_width="@dimen/drawer_model_chevron_size"
                        android:layout_height="@dimen/drawer_model_chevron_size"
                        android:contentDescription="@string/open"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/drawer_model_divider_margin_h"
                    android:layout_marginEnd="@dimen/drawer_model_divider_margin_h"
                    android:background="@drawable/bg_drawer_model_divider" />

                <LinearLayout
                    android:id="@+id/localModelDetailRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/drawer_model_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/drawer_model_indented_text_start"
                    android:paddingTop="10dp"
                    android:paddingEnd="@dimen/drawer_model_row_padding_h"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/localModelDetailTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/local_model_url_label"
                            android:textColor="#333333"
                            android:textSize="@dimen/drawer_model_title_text_size" />

                        <TextView
                            android:id="@+id/localModelDetailSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/drawer_model_text_gap"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="#6A6A6A"
                            android:textSize="@dimen/drawer_model_value_text_size" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/localModelCopyButton"
                        android:layout_width="@dimen/drawer_model_copy_button_size"
                        android:layout_height="@dimen/drawer_model_copy_button_size"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/local_model_url_label"
                        android:padding="6.5dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_local_model_copy" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
