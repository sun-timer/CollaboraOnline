<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/local_model_title"
            android:textColor="#202124"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/local_model_capability_hint"
            android:textColor="#5F6368"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/localModelStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#202124"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/localModelProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/localModelProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#5F6368"
            android:visibility="gone" />

        <Button
            android:id="@+id/localModelDownloadButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="@string/local_model_download" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/localModelEnableSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/local_model_enable"
            android:enabled="false" />

        <Button
            android:id="@+id/localModelDeleteButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/local_model_delete"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
